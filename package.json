{
  "name": "@oneonefour/rkui",
  "version": "0.0.1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OneOneFour/rkui.git"
  },
  "homepage": "https://www.robertcking.com/rkui/",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./styles.css": "./src/index.css",
    "./tokens/*": "./src/tokens/*",
    "./base/*": "./src/base/*",
    "./rkui.css": "./dist/rkui.css",
    "./rkui.js": "./dist/rkui.js",
    "./components/*.js": {
      "types": "./dist/types/components/*.d.ts",
      "default": "./src/components/*.js"
    },
    "./components/*": "./src/components/*",
    "./shared/*.js": {
      "types": "./dist/types/shared/*.d.ts",
      "default": "./src/shared/*.js"
    },
    "./shared/*": "./src/shared/*",
    "./head-scripts/*": "./src/head-scripts/*",
    "./icons/*": "./dist/icons/*",
    "./fonts/*": "./src/fonts/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node build/index.js && astro check --root site && astro build --root site",
    "preview": "vite preview --outDir site/dist --base /rkui/ --port 4322 --strictPort",
    "dev": "node build/index.js && astro dev --root site --port 4321",
    "prepack": "node build/index.js",
    "format": "prettier --write .",
    "screenshots": "playwright test"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    }
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/mdx": "^8.1.2",
    "@playwright/test": "^1.64.1",
    "astro": "^7.0.7",
    "katex": "^0.19.1",
    "lightningcss": "^1.33.0",
    "pagefind": "^1.6.0",
    "phosphor-raw": "https://codeload.github.com/phosphor-icons/core/tar.gz/fe23e2534cdb7bec24bd8e6bd99b3676bcf0d54f",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "rolldown": "~1.2.16",
    "svgo": "^4.1.0",
    "typescript": "^5.7.3"
  }
}
