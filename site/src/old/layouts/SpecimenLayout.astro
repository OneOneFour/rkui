---
// KaTeX's stylesheet comes first, so rkui's maths styles win.
import 'katex/dist/katex.min.css'
import '@oneonefour/rkui/rkui.css'
import themeInit from '@oneonefour/rkui/head-scripts/theme-init.js?raw'
import ThemeToggle from '@oneonefour/rkui/components/theme-toggle/ThemeToggle.astro'
import PaletteSwitcher from '../components/PaletteSwitcher.astro'
import ShadowSwitcher from '../components/ShadowSwitcher.astro'
import BackToTop from '@oneonefour/rkui/components/topbar/BackToTop.astro'

interface Props {
  title: string
}

const { title } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline set:html={themeInit} />
    <script is:inline>
      // Inline, like the theme, so a stored palette or shadow mode doesn't flash the default first.
      try {
        const palette = localStorage.getItem('rkui-palette')
        if (palette) document.documentElement.dataset.palette = palette
        const shadow = localStorage.getItem('rkui-shadow')
        if (shadow) document.documentElement.dataset.shadow = shadow
      } catch {
        // Storage is blocked, so the page keeps the defaults.
      }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="icon"
      type="image/x-icon"
      href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.ico`}
    />
    <title>{title}</title>
  </head>
  <body>
    <header class="specimen-header rkui-topbar rkui-topbar--toast">
      <ShadowSwitcher />
      <PaletteSwitcher />
      <ThemeToggle />
      <BackToTop />
    </header>
    <script is:inline>
      // ?topbar=flush swaps in the other top bar, to compare the two live.
      if (new URLSearchParams(location.search).get('topbar') === 'flush') {
        document
          .querySelector('.specimen-header')
          .classList.replace('rkui-topbar--toast', 'rkui-topbar--flush')
      }
    </script>
    <slot />
  </body>
</html>

<style>
  /* Lines the bar's controls up with the end of the page's 96rem column. */
  .specimen-header {
    --rkui-topbar-inset: max(var(--rkui-space-4), (100% - 96rem) / 2);
  }
</style>
