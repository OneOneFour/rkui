---
/** A widget frame with a placeholder SVG on the stage and a row of controls. */
import WidgetFrame from '@oneonefour/rkui/components/widget-frame/WidgetFrame.astro'
import Button from '@oneonefour/rkui/components/button/Button.astro'
import PlayIcon from '@oneonefour/rkui/icons/play.svg'
import ResetIcon from '@oneonefour/rkui/icons/arrow-counter-clockwise.svg'
---

<WidgetFrame title="Widget title">
  <svg viewBox="0 0 320 160" role="img" aria-label="Placeholder figure">
    <path class="trace" d="M10 80 C 60 10, 100 150, 160 80 S 260 10, 310 80" />
  </svg>
  <Fragment slot="controls">
    <Button hue="coral">
      <PlayIcon class="rkui-icon" />
      Start
    </Button>
    <Button unfilled>
      <ResetIcon class="rkui-icon" />
      Reset
    </Button>
    <input class="rkui-range slider" type="range" aria-label="Specimen" />
  </Fragment>
</WidgetFrame>

<style>
  .trace {
    fill: none;
    stroke: var(--rkui-grape-deep);
    stroke-width: 4;
    stroke-linecap: round;
  }

  .slider {
    flex: 1 1 10rem;
    inline-size: auto;
  }
</style>
