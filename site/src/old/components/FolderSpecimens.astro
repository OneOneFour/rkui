---
/**
 * Folder tabs: live tabbed panels on a plain and a tinted sheet, the join with each tab selected,
 * and a tab's states.
 */
import Tab from '@oneonefour/rkui/components/folder/Tab.vue'
import Tabs from '@oneonefour/rkui/components/folder/Tabs.vue'
import Specimen from './Specimen.astro'
import SpecimenRow from './SpecimenRow.astro'

const TABS = ['Tab one', 'Tab two', 'Tab three']
const SHEETS = [
  { label: 'live, plain sheet', tinted: false },
  { label: 'live, .rkui-folder--tinted', tinted: true },
]
const STATIC_TABS = ['One', 'Two', 'Three']

/** A static folder: which tab is selected, and optionally a state class on one tab */
interface StaticFolder {
  label: string
  selected: number
  tinted?: boolean
  state?: { tab: number; class: string }
}

const JOINS: StaticFolder[] = [
  { label: 'second tab selected', selected: 1 },
  { label: 'third tab selected', selected: 2 },
  { label: 'third tab selected, tinted', selected: 2, tinted: true },
]
const STATES: StaticFolder[] = [
  { label: 'second tab hover', selected: 0, state: { tab: 1, class: 'is-hover' } },
  { label: 'second tab pressed', selected: 0, state: { tab: 1, class: 'is-active' } },
  { label: 'second tab focused', selected: 0, state: { tab: 1, class: 'is-focus' } },
  { label: 'selected tab focused', selected: 0, state: { tab: 0, class: 'is-focus' } },
]
---

<SpecimenRow title="Live">
  {SHEETS.map((sheet) => (
    <Specimen label={sheet.label} wide>
      <Tabs label="Specimen" tinted={sheet.tinted}>
        {TABS.map((name) => (
          <Tab label={name}>
            <p>Panel for {name.toLowerCase()}.</p>
          </Tab>
        ))}
      </Tabs>
    </Specimen>
  ))}
</SpecimenRow>

{[
  { title: 'The join', specimens: JOINS },
  { title: 'States', specimens: STATES },
].map((row) => (
  <SpecimenRow title={row.title}>
    {row.specimens.map((specimen) => (
      <Specimen label={specimen.label}>
        <div class:list={['rkui-folder', { 'rkui-folder--tinted': specimen.tinted }]}>
          <ul class="rkui-folder-tabs rkui-scroll" aria-label="Specimen" tabindex="0">
            {STATIC_TABS.map((name, i) => (
              <li>
                <span
                  class:list={[
                    'rkui-folder-tab',
                    specimen.state?.tab === i && specimen.state.class,
                  ]}
                  aria-current={i === specimen.selected ? 'true' : undefined}
                >
                  {name}
                </span>
              </li>
            ))}
          </ul>
          <div class="rkui-folder-sheet">
            <p>Panel.</p>
          </div>
        </div>
      </Specimen>
    ))}
  </SpecimenRow>
))}

<style>
  .rkui-folder-sheet p {
    margin: 0;
  }
</style>
