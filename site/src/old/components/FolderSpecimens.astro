---
/**
 * Folder: live tabbed panels on a plain and a tinted sheet, the join with each tab selected,
 * and a tab's states.
 *
 * @param theme the panel's theme, used to keep the radios' names unique across the two panels
 */
import Folder from '@oneonefour/rkui/components/folder/Folder.vue'
import Tab from '@oneonefour/rkui/components/folder/Tab.vue'
import Specimen from './Specimen.astro'
import SpecimenRow from './SpecimenRow.astro'
import StateFolder from './StateFolder.astro'

interface Props {
  theme: 'light' | 'dark'
}

const { theme } = Astro.props
const TABS = ['Tab one', 'Tab two', 'Tab three']
const SHEETS = [
  { label: 'live, plain sheet', tinted: false },
  { label: 'live, .rkui-folder--tinted', tinted: true },
]
const STATIC_TABS = ['One', 'Two', 'Three']

const JOINS = [
  { label: 'second tab selected', selected: 1 },
  { label: 'third tab selected', selected: 2 },
  { label: 'third tab selected, tinted', selected: 2, tinted: true },
]
const STATES = [
  { label: 'second tab hover', state: { tab: 1, class: 'is-hover' } },
  { label: 'second tab pressed', state: { tab: 1, class: 'is-active' } },
  { label: 'second tab focused', state: { tab: 1, class: 'is-focus' } },
  { label: 'selected tab focused', state: { tab: 0, class: 'is-focus' } },
]
---

<SpecimenRow title="Live">
  {SHEETS.map((sheet) => (
    <Specimen label={sheet.label} wide>
      <Folder label="Specimen" tinted={sheet.tinted}>
        {TABS.map((name) => (
          <Tab label={name}>
            <p>Panel for {name.toLowerCase()}.</p>
          </Tab>
        ))}
      </Folder>
    </Specimen>
  ))}
</SpecimenRow>

<SpecimenRow title="The join">
  {JOINS.map((specimen) => (
    <Specimen label={specimen.label}>
      <Folder label="Specimen" tinted={specimen.tinted}>
        {STATIC_TABS.map((name, i) => (
          <Tab label={name} selected={i === specimen.selected}>
            <p>Panel.</p>
          </Tab>
        ))}
      </Folder>
    </Specimen>
  ))}
</SpecimenRow>

<SpecimenRow title="States">
  {STATES.map((specimen, i) => (
    <Specimen label={specimen.label}>
      <StateFolder
        name={`${theme}-folder-state-${i}`}
        tabs={STATIC_TABS}
        selected={0}
        state={specimen.state}
      />
    </Specimen>
  ))}
</SpecimenRow>

<style>
  /* The sheets are drawn by Folder, outside this file's scope; the paragraphs are this file's. */
  :global(.rkui-folder-sheet) p {
    margin: 0;
  }
</style>
