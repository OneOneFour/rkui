---
/**
 * The styleguide's dark-mode switches, shadow and highlight: each sets data-shadow or
 * data-highlight on <html> and remembers the choice under `rkui-shadow` or `rkui-highlight`.
 * SpecimenLayout applies the stored choices before first paint.
 */
const switches = [
  {
    name: 'shadow',
    legend: 'Dark-mode shadow',
    options: [
      { value: 'outline', label: 'Outline' },
      { value: 'block', label: 'Block' },
      { value: 'color', label: 'Colour' },
    ],
  },
  {
    name: 'highlight',
    legend: 'Dark-mode highlight',
    options: [
      { value: 'cream', label: 'Cream' },
      { value: 'dark', label: 'Dark' },
    ],
  },
]
---

{switches.map(({ name, legend, options }) => (
  <fieldset class="rkui-segmented shadow-switcher" data-mode={name}>
    <legend class="rkui-visually-hidden">{legend}</legend>
    {options.map(({ value, label }) => (
      <label>
        <input type="radio" name={`rkui-${name}`} value={value} />
        {label}
      </label>
    ))}
  </fieldset>
))}

<script>
  import { afterSlide } from '@oneonefour/rkui/shared/after-slide.js'

  const root = document.documentElement

  for (const fieldset of document.querySelectorAll<HTMLElement>('.shadow-switcher')) {
    const name = fieldset.dataset.mode ?? ''
    const radios = [...fieldset.querySelectorAll('input')]
    // The stored choice, or the default where there is none or it is no longer an option.
    const current = radios.find((radio) => radio.value === root.dataset[name]) ?? radios[0]

    for (const radio of radios) {
      radio.checked = radio === current
      radio.addEventListener('change', () => {
        afterSlide(radio, () => (root.dataset[name] = radio.value))
        try {
          localStorage.setItem(`rkui-${name}`, radio.value)
        } catch {
          // Storage is blocked, so the choice lasts only until the page is left.
        }
      })
    }
  }
</script>
