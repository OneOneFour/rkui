---
/**
 * The two dial variants, live with a decimal and an integer range and disabled, the ramp with the
 * two ramps rkui has, and how a dial looks without JavaScript.
 *
 * @param theme the panel's theme, used to keep ids unique across the two panels
 */
import Dial from '@oneonefour/rkui/components/dial/Dial.vue'
import Specimen from './Specimen.astro'
import SpecimenRow from './SpecimenRow.astro'

interface Props {
  theme: 'light' | 'dark'
}

const { theme } = Astro.props
const VARIANTS = [
  { name: 'knob', title: 'A: knob (rkui-dial--knob)' },
  { name: 'arc', title: 'B: arc (rkui-dial--arc)' },
] as const
const RANGES = [
  {
    name: 'temperature',
    label: 'Temperature',
    caption: '10 to 30, step 0.5',
    min: 10,
    max: 30,
    step: 0.5,
    value: 20,
  },
  {
    name: 'level',
    label: 'Level',
    caption: '0 to 100, step 1',
    min: 0,
    max: 100,
    step: 1,
    value: 40,
  },
  {
    name: 'disabled',
    label: 'Label',
    caption: 'disabled',
    min: 0,
    max: 100,
    step: 1,
    value: 40,
    disabled: true,
  },
]
const RAMPS = [
  { name: 'knob', variant: 'knob', ramp: 'cool', caption: 'knob, cool to warm' },
  { name: 'arc', variant: 'arc', ramp: 'cool', caption: 'arc, cool to warm' },
  { name: 'heat', variant: 'arc', ramp: 'heat', caption: 'arc, rkui-dial--ramp-heat' },
] as const
---

{VARIANTS.map((variant) => (
  <SpecimenRow title={variant.title}>
    {RANGES.map((range) => (
      <Specimen label={range.caption}>
        <Dial
          client:visible
          id={`${theme}-dial-${variant.name}-${range.name}`}
          variant={variant.name}
          label={range.label}
          min={range.min}
          max={range.max}
          step={range.step}
          value={range.value}
          disabled={range.disabled}
        />
      </Specimen>
    ))}
  </SpecimenRow>
))}

<SpecimenRow title="Ramps (rkui-dial--ramp)">
  {RAMPS.map((ramp) => (
    <Specimen label={ramp.caption}>
      <Dial
        client:visible
        id={`${theme}-dial-ramp-${ramp.name}`}
        variant={ramp.variant}
        ramp={ramp.ramp}
        label="Temperature"
        min="10"
        max="30"
        step="0.5"
        value="21"
      />
    </Specimen>
  ))}
</SpecimenRow>

<SpecimenRow title="Without JavaScript">
  <Specimen
    label="the face hidden, the range at its foot; the readout keeps its starting value"
    wide
  >
    <Dial
      id={`${theme}-dial-fallback`}
      label="Temperature"
      min="10"
      max="30"
      step="0.5"
      value="20"
    />
  </Specimen>
</SpecimenRow>
