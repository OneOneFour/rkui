---
/**
 * The dark-mode shadows (outline, the default, block and color) with each highlight (cream, the
 * default, and dark), each on a few raised things: fills that cast their own shade in color, and
 * things that cast the lit shadow instead.
 *
 * @param theme the panel's theme, used to keep ids and names unique across the two panels
 */
import Button from '@oneonefour/rkui/components/button/Button.vue'
import Card from '@oneonefour/rkui/components/card/Card.vue'
import Chip from '@oneonefour/rkui/components/chip/Chip.vue'
import ChipGroup from '@oneonefour/rkui/components/chip/ChipGroup.vue'
import Ballot from './Ballot.astro'
import Specimen from './Specimen.astro'
import SpecimenRow from './SpecimenRow.astro'
import TilePicker from './TilePicker.astro'

interface Props {
  theme: 'light' | 'dark'
}

const { theme } = Astro.props
const MODES = ['outline', 'block', 'color'].flatMap((shadow) =>
  ['cream', 'dark'].map((highlight) => ({
    shadow,
    highlight,
    title: `data-shadow="${shadow}" data-highlight="${highlight}"`,
  })),
)
const FILLS = ['navy', 'coral', 'grape', 'teal'] as const
const KEYS = ['One', 'Two', 'Three']
const TILES = ['1', '2', '3'].map((number) => ({ value: number, label: number }))
const BALLOT = ['teal', 'green'].map((color) => ({
  value: color,
  title: color[0].toUpperCase() + color.slice(1),
  color,
  checked: color === 'green',
}))
---

{MODES.map(({ shadow, highlight, title }) => {
  const prefix = `${theme}-shadow-${shadow}-${highlight}`
  return (
    <div data-shadow={shadow} data-highlight={highlight}>
      <SpecimenRow title={title}>
        <Specimen label="buttons: yellow, navy, coral, grape, teal">
          <Button>Button</Button>
          {FILLS.map((fill) => (
            <Button hue={fill}>Button</Button>
          ))}
        </Specimen>
        <Specimen label="yellow: hover, pressed">
          <Button class="is-hover">Button</Button>
          <Button class="is-active">Button</Button>
        </Specimen>
        <Specimen label="checkbox: off, on">
          <label class="rkui-check">
            <input class="rkui-checkbox" type="checkbox" name={`${prefix}-off`} /> Label
          </label>
          <label class="rkui-check">
            <input class="rkui-checkbox" type="checkbox" name={`${prefix}-on`} checked /> Label
          </label>
        </Specimen>
        <Specimen label="chips">
          <ChipGroup legend="Specimen">
            <Chip name={`${prefix}-chip`} value="one" checked>
              One
            </Chip>
            <Chip name={`${prefix}-chip`} value="two">
              Two
            </Chip>
          </ChipGroup>
        </Specimen>
        <Specimen label="deck keys on a plate">
          <fieldset class="rkui-segmented rkui-segmented--deck rkui-segmented--plate">
            <legend class="rkui-visually-hidden">Specimen</legend>
            {KEYS.map((key, i) => (
              <label>
                <input type="radio" name={`${prefix}-plate`} value={key} checked={i === 0} />
                {key}
              </label>
            ))}
          </fieldset>
        </Specimen>
        <Specimen label="tiles (2 checked), a ballot with colour tiles">
          <TilePicker legend="Specimen" name={`${prefix}-tiles`} tiles={TILES} checked={['2']} />
          <Ballot legend="Specimen" name={`${prefix}-ballot`} options={BALLOT} />
        </Specimen>
        <Specimen label="linked card" wide>
          <Card title="Card title" href="#specimen-link" meta="Meta line">
            <p>Body text.</p>
          </Card>
        </Specimen>
      </SpecimenRow>
    </div>
  )
})}
