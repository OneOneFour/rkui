---
/**
 * Everything that shows waiting: the spinners, their sizes and labels, the progress bar and the
 * meter, filling buttons, the pending panel and the hopping-ball loader.
 */
import Button from '@oneonefour/rkui/components/button/Button.vue'
import AtomIcon from '@oneonefour/rkui/icons/atom.svg'
import LightningIcon from '@oneonefour/rkui/icons/lightning.svg'
import StarIcon from '@oneonefour/rkui/icons/star.svg'
import Specimen from './Specimen.astro'
import SpecimenRow from './SpecimenRow.astro'

const DOT_SPINNERS = [
  { label: '.rkui-spinner--triangle', class: 'rkui-spinner--triangle' },
  {
    label: '.rkui-spinner--dots.rkui-spinner--squash',
    class: 'rkui-spinner--dots rkui-spinner--squash',
  },
  { label: '.rkui-spinner--orbit (an alternate)', class: 'rkui-spinner--orbit' },
]
const METERS = [
  { label: 'good (optimum range)', value: 0.3 },
  { label: 'middling', value: 0.7 },
  { label: 'bad', value: 0.92 },
]
const FILLS = [undefined, 'teal', 'navy', 'coral', 'grape'] as const
const LEVELS = [0.25, 0.5, 0.85]
const BALLS = [
  { label: 'teal (the default)' },
  { label: 'in coral', fill: 'coral' },
  { label: 'in grape', fill: 'grape' },
  { label: 'with an icon, in yellow', fill: 'yellow', Icon: StarIcon },
  { label: 'with an icon, in green', fill: 'green', Icon: AtomIcon },
  { label: 'with an icon, in navy', fill: 'navy', onFill: 'on-navy', Icon: LightningIcon },
]
---

<SpecimenRow title="Spinners">
  <Specimen label=".rkui-spinner--ring">
    <span class="rkui-spinner rkui-spinner--ring" role="status">
      <span class="rkui-visually-hidden">Loading…</span>
    </span>
  </Specimen>
  <Specimen label=".rkui-spinner--dots">
    <span class="rkui-spinner rkui-spinner--dots" role="status">
      <span class="rkui-spinner-dot"></span>
      <span class="rkui-spinner-dot"></span>
      <span class="rkui-spinner-dot"></span>
      <span class="rkui-visually-hidden">Loading…</span>
    </span>
  </Specimen>
  <Specimen label=".rkui-spinner--water, filling">
    <span class="rkui-spinner rkui-spinner--water" role="status">
      <span class="rkui-water rkui-water--rise" aria-hidden="true"></span>
      <span class="rkui-visually-hidden">Loading…</span>
    </span>
  </Specimen>
  {DOT_SPINNERS.map((spinner) => (
    <Specimen label={spinner.label}>
      <span class:list={['rkui-spinner', spinner.class]} role="status">
        <span class="rkui-spinner-dot" />
        <span class="rkui-spinner-dot" />
        <span class="rkui-spinner-dot" />
        <span class="rkui-visually-hidden">Loading…</span>
      </span>
    </Specimen>
  ))}
</SpecimenRow>

<SpecimenRow title="Spinner sizes and labels (--rkui-spinner-size, --rkui-spinner-fill)">
  <Specimen label="ring: small, with a visible label">
    <span class="loading" role="status">
      <span
        class="rkui-spinner rkui-spinner--ring"
        style="--rkui-spinner-size: 1.25rem"
        aria-hidden="true"
      ></span>
      Loading…
    </span>
  </Specimen>
  <Specimen label="ring: large, --rkui-spinner-fill set to teal">
    <span
      class="rkui-spinner rkui-spinner--ring"
      style="--rkui-spinner-size: 3rem; --rkui-spinner-fill: var(--rkui-teal)"
      role="status"
    >
      <span class="rkui-visually-hidden">Loading…</span>
    </span>
  </Specimen>
  <Specimen label="dots: small, with a visible label">
    <span class="loading" role="status">
      <span
        class="rkui-spinner rkui-spinner--dots"
        style="--rkui-spinner-size: 1.25rem"
        aria-hidden="true"
      >
        <span class="rkui-spinner-dot"></span>
        <span class="rkui-spinner-dot"></span>
        <span class="rkui-spinner-dot"></span>
      </span>
      Loading…
    </span>
  </Specimen>
  <Specimen label="water: large, --rkui-spinner-fill set to teal">
    <span
      class="rkui-spinner rkui-spinner--water"
      style="--rkui-spinner-size: 3rem; --rkui-spinner-fill: var(--rkui-teal)"
      role="status"
    >
      <span class="rkui-water rkui-water--rise" aria-hidden="true"></span>
      <span class="rkui-visually-hidden">Loading…</span>
    </span>
  </Specimen>
  <Specimen label="water: small, with a visible label">
    <span class="loading" role="status">
      <span
        class="rkui-spinner rkui-spinner--water"
        style="--rkui-spinner-size: 1.25rem"
        aria-hidden="true"
      >
        <span class="rkui-water rkui-water--rise"></span>
      </span>
      Loading…
    </span>
  </Specimen>
  <Specimen label="triangle: large">
    <span
      class="rkui-spinner rkui-spinner--triangle"
      style="--rkui-spinner-size: 3rem"
      role="status"
    >
      <span class="rkui-spinner-dot"></span>
      <span class="rkui-spinner-dot"></span>
      <span class="rkui-spinner-dot"></span>
      <span class="rkui-visually-hidden">Loading…</span>
    </span>
  </Specimen>
</SpecimenRow>

<SpecimenRow title="Progress bars">
  <Specimen label="striped (the default)" wide>
    <label class="rkui-field">
      Label{' '}
      <progress class="rkui-progress" max="100" value="65">
        65%
      </progress>
    </label>
  </Specimen>
  <Specimen label="flat (.rkui-progress--flat)" wide>
    <label class="rkui-field">
      Label{' '}
      <progress class="rkui-progress rkui-progress--flat" max="100" value="40">
        40%
      </progress>
    </label>
  </Specimen>
  <Specimen label="striped, indeterminate (no value)" wide>
    <label class="rkui-field">
      Label <progress class="rkui-progress"></progress>
    </label>
  </Specimen>
  <Specimen label="flat, indeterminate (no value)" wide>
    <label class="rkui-field">
      Label <progress class="rkui-progress rkui-progress--flat"></progress>
    </label>
  </Specimen>
</SpecimenRow>

<SpecimenRow title="Meter (a measurement, not progress)">
  {METERS.map((meter) => (
    <Specimen label={meter.label} wide>
      <label class="rkui-field">
        Label
        <meter
          class="rkui-meter"
          min="0"
          max="1"
          low="0.6"
          high="0.85"
          optimum="0.2"
          value={meter.value}
        />
      </label>
    </Specimen>
  ))}
</SpecimenRow>

<SpecimenRow title="Filling buttons (aria-busy, with an .rkui-water child)">
  <Specimen label="filling: yellow, teal, navy, coral, grape">
    {FILLS.map((fill) => (
      <Button color={fill} aria-busy="true" aria-disabled="true">
        <span class="rkui-water rkui-water--rise" aria-hidden="true" />
        Saving…
      </Button>
    ))}
  </Specimen>
  <Specimen label="set by --rkui-water-level: 0.25, 0.5, 0.85">
    {LEVELS.map((level) => (
      <Button
        color="teal"
        aria-busy="true"
        aria-disabled="true"
        style={`--rkui-water-level: ${level}`}
      >
        <span class="rkui-water" aria-hidden="true" />
        Uploading<span class="rkui-visually-hidden"> {level * 100}%</span>
      </Button>
    ))}
  </Specimen>
  <Specimen label="not busy: the water is hidden">
    <Button color="teal">
      <span class="rkui-water" aria-hidden="true"></span>
      Upload
    </Button>
  </Specimen>
</SpecimenRow>

<SpecimenRow title="Pending panel (.rkui-pending)">
  <Specimen label="filling up" wide>
    <div class="rkui-pending" role="status">
      <span class="rkui-water rkui-water--rise" aria-hidden="true"></span>
      <p>Loading…</p>
    </div>
  </Specimen>
</SpecimenRow>

<SpecimenRow title="Hopping-ball loader: --rkui-loader-fill, --rkui-loader-on-fill and .rkui-loader-ball">
  {BALLS.map(({ label, fill, onFill, Icon }) => (
    <Specimen label={label} wide>
      <div
        class="rkui-loader rkui-loader--hop"
        role="status"
        style={
          fill &&
          `--rkui-loader-fill: var(--rkui-${fill})${onFill ? `; --rkui-loader-on-fill: var(--rkui-${onFill})` : ''}`
        }
      >
        {Icon && (
          <span class="rkui-loader-ball">
            <Icon class="rkui-icon" aria-hidden="true" />
          </span>
        )}
        <span class="rkui-visually-hidden">Loading…</span>
      </div>
    </Specimen>
  ))}
</SpecimenRow>

<style>
  .loading {
    display: inline-flex;
    align-items: center;
    gap: var(--rkui-space-2);
  }
</style>
