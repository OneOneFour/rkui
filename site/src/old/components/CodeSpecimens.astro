---
/**
 * Code blocks with live copy buttons: the default box in each language with a logo, the two
 * fallbacks (file icon, extension text), the editor tab, the greige palette's panel, and inline code in a
 * sentence.
 */
import CodeBlock from '@oneonefour/rkui/components/code/CodeBlock.vue'
import { siCplusplus, siFortran, siJulia, siMarkdown, siPython } from 'simple-icons'
import LanguageLogo from '../../components/LanguageLogo.vue'
import Specimen from './Specimen.astro'
import SpecimenRow from './SpecimenRow.astro'
import { LORENZ_PYTHON } from './code-samples'
---

<SpecimenRow title="Code block">
  <Specimen label="Python, with caption" wide>
    <CodeBlock client:visible lang="python" label="Python">
      {LORENZ_PYTHON}
      <LanguageLogo slot="logo" icon={siPython} />
    </CodeBlock>
  </Specimen>
  <Specimen label="Julia" wide>
    <CodeBlock client:visible lang="julia" label="Julia">
      σ, ρ, β = 10.0, 28.0, 8 / 3
      <LanguageLogo slot="logo" icon={siJulia} />
    </CodeBlock>
  </Specimen>
  <Specimen label="Fortran" wide>
    <CodeBlock client:visible lang="fortran-free-form" label="Fortran">
      real :: sigma = 10.0, rho = 28.0
      <LanguageLogo slot="logo" icon={siFortran} />
    </CodeBlock>
  </Specimen>
  <Specimen label="C++" wide>
    <CodeBlock client:visible lang="cpp" label="C++">
      double sigma = 10.0, rho = 28.0;
      <LanguageLogo slot="logo" icon={siCplusplus} />
    </CodeBlock>
  </Specimen>
  <Specimen label="Markdown (wide mark)" wide>
    <CodeBlock client:visible lang="markdown" label="Markdown">
      **β ≈ 0.3** in the [paper](#)
      <LanguageLogo slot="logo" icon={siMarkdown} />
    </CodeBlock>
  </Specimen>
  <Specimen label="no logo: file icon (TypeScript)" wide>
    <CodeBlock client:visible lang="typescript" label="TypeScript">
      const sigma: number = 10
    </CodeBlock>
  </Specimen>
  <Specimen label="no logo, no icon: extension text (LaTeX)" wide>
    <CodeBlock client:visible lang="latex" label="LaTeX">
      {'\\dot{x} = \\sigma (y - x)'}
    </CodeBlock>
  </Specimen>
  <Specimen label="no logo, no icon, extension repeats the label (JSON)" wide>
    <CodeBlock client:visible lang="json" label="JSON">
      {'{ "sigma": 10 }'}
    </CodeBlock>
  </Specimen>
  <Specimen label="no caption" wide>
    <CodeBlock client:visible lang="python">
      x = lorenz(1.0, 1.0, 1.0)
    </CodeBlock>
  </Specimen>
</SpecimenRow>

<SpecimenRow title="Editor tab (editor)">
  <Specimen label="Python, with caption" wide>
    <CodeBlock client:visible lang="python" label="Python" editor>
      {LORENZ_PYTHON}
      <LanguageLogo slot="logo" icon={siPython} />
    </CodeBlock>
  </Specimen>
  <Specimen label="no caption" wide>
    <CodeBlock client:visible lang="python" editor>
      x = lorenz(1.0, 1.0, 1.0)
    </CodeBlock>
  </Specimen>
</SpecimenRow>

<SpecimenRow title={'Greige palette (data-palette="greige")'}>
  <Specimen label="default box" wide>
    <CodeBlock client:visible lang="python" label="Python" data-palette="greige">
      {LORENZ_PYTHON}
      <LanguageLogo slot="logo" icon={siPython} />
    </CodeBlock>
  </Specimen>
  <Specimen label="inline code" wide>
    <p data-palette="greige">
      Call <code>lorenz(x, y, z)</code> for the derivatives, then <code>step(state, dt)</code> once
      per frame with <code>Δt = 0.01</code>.
    </p>
  </Specimen>
</SpecimenRow>
