---
/** Turns the light for the whole page (rkui's LightDirection), to check every shadow. */
import LightDirection from '@oneonefour/rkui/components/light-direction/LightDirection.vue'
---

<LightDirection client:visible class="light-direction" />

<style>
  .light-direction {
    display: grid;
    gap: var(--rkui-space-3);
    max-inline-size: 30rem;
  }
</style>
