---
/**
 * Diagrams in the toon style: a neural network whose nodes light their links on hover or focus,
 * and a flow chart whose steps light up in turn. Each pauses from its button.
 *
 * @param theme the panel's theme, passed on to keep SVG ids unique
 */
import Motion from '@oneonefour/rkui/components/motion/Motion.vue'
import FlowChart from './FlowChart.astro'
import NeuralNetwork from './NeuralNetwork.astro'
import Specimen from './Specimen.astro'
import SpecimenRow from './SpecimenRow.astro'
import './diagram.css'

interface Props {
  theme: 'light' | 'dark'
}

const { theme } = Astro.props
---

<SpecimenRow title="Neural network: hover or focus a node to light its links">
  <Specimen
    label="pulses travel a layer at a time (--rkui-loop-long); nodes squash as they land"
    wide
  >
    <Motion class="diagram">
      <NeuralNetwork theme={theme} />
    </Motion>
  </Specimen>
</SpecimenRow>

<SpecimenRow title="Flow chart: the steps light up in turn">
  <Specimen
    label="one step per sixth of --rkui-loop-panel; step 2 fills with water while it runs"
    wide
  >
    <Motion class="diagram">
      <FlowChart theme={theme} />
    </Motion>
  </Specimen>
</SpecimenRow>

<style>
  .diagram {
    display: grid;
    justify-items: start;
    gap: var(--rkui-space-3);
  }
</style>
