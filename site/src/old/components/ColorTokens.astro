---
import Swatch from './Swatch.astro'
import { colorGroups } from './color-tokens'
import { SUMMARY_NAMES } from './color-summary'
import './chart-tokens.css'
import './illustration-tokens.css'

/**
 * The colour tokens the summary leaves out, from the package's token files and the styleguide's
 * chart and illustration tokens, grouped as the files group them. The theme is the panel it sits
 * in.
 */
const groups = colorGroups()
  .map((group) => ({ ...group, names: group.names.filter((name) => !SUMMARY_NAMES.has(name)) }))
  .filter((group) => group.names.length > 0)
---

{groups.map((group) => (
  <>
    <h3>{group.title}</h3>
    {group.caption && <p class="caption">{group.caption}</p>}
    <div class="swatches">
      {group.names.map((name) => (
        <Swatch name={name} />
      ))}
    </div>
  </>
))}

<style>
  h3 {
    margin-block: var(--rkui-space-5) var(--rkui-space-3);
    font-size: var(--rkui-step-1);
  }

  .caption {
    max-width: 65ch;
    margin-block: calc(-1 * var(--rkui-space-2)) var(--rkui-space-3);
    color: var(--rkui-muted);
    font-size: var(--rkui-step--1);
  }

  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr));
    gap: var(--rkui-space-4);
  }
</style>
