---
/**
 * The settable clock, live by day and by night and disabled, plus how it looks without JavaScript.
 *
 * @param theme the panel's theme, used to keep ids unique across the two panels
 */
import Clock from '@oneonefour/rkui/components/clock/Clock.vue'
import Specimen from './Specimen.astro'
import SpecimenRow from './SpecimenRow.astro'

interface Props {
  theme: 'light' | 'dark'
}

const { theme } = Astro.props
const CLOCKS = [
  { name: 'day', label: 'Wake up', caption: 'by day, five-minute steps', value: '07:30' },
  { name: 'night', label: 'Lights out', caption: 'by night', value: '22:45' },
  { name: 'disabled', label: 'Label', caption: 'disabled', value: '12:00', disabled: true },
]
---

<SpecimenRow title="Clock">
  {CLOCKS.map((clock) => (
    <Specimen label={clock.caption}>
      <Clock
        client:visible
        id={`${theme}-clock-${clock.name}`}
        label={clock.label}
        value={clock.value}
        disabled={clock.disabled}
      />
    </Specimen>
  ))}
</SpecimenRow>

<SpecimenRow title="Without JavaScript">
  <Specimen label="the face hidden, the time input on its own">
    <Clock id={`${theme}-clock-fallback`} label="Wake up" value="07:30" />
  </Specimen>
</SpecimenRow>
