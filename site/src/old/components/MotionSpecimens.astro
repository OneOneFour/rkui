---
/**
 * The motion policy's core patterns side by side (PLAN §5.7): an input response, ambient loops in
 * each easing, a stagger, squash and settle, and the reduced-motion fallbacks. The pause button
 * pauses them all.
 */
import Button from '@oneonefour/rkui/components/button/Button.vue'
import Motion from '@oneonefour/rkui/components/motion/Motion.vue'
import Specimen from './Specimen.astro'
import SpecimenRow from './SpecimenRow.astro'

const EASINGS = [
  { label: 'ease: input responses', easing: 'ease' },
  {
    label: '--rkui-ease-spring: recovering from a squash or press',
    easing: 'var(--rkui-ease-spring)',
  },
  { label: '--rkui-ease-snap: a jump to a new place', easing: 'var(--rkui-ease-snap)' },
]
const STAGGERED = ['--rkui-teal', '--rkui-yellow', '--rkui-navy', '--rkui-green', '--rkui-coral']
---

<Motion>
  <SpecimenRow title="Input response: hover or press">
    <Specimen label="--rkui-duration-fast, ease: lifts on hover, sinks on press">
      <Button color="teal">Button</Button>
    </Specimen>
    <Specimen label="reduced motion: the shadow changes, nothing moves">
      <div class="reduced-input">
        <Button color="teal">Button</Button>
      </div>
    </Specimen>
  </SpecimenRow>

  <SpecimenRow title="Ambient loop: hold, move, hold, one --rkui-loop-medium cycle">
    {EASINGS.map((item) => (
      <Specimen label={item.label} wide>
        <div class="track">
          <span class="block hop" style={`--rkui-hop-ease: ${item.easing}`} />
        </div>
      </Specimen>
    ))}
  </SpecimenRow>

  <SpecimenRow title="Stagger: neighbours start --rkui-stagger apart">
    <Specimen
      label="entering in reading order, holding, then leaving in the same order (--rkui-loop-panel)"
      wide
    >
      <div class="stagger">
        {STAGGERED.map((fill, i) => (
          <span class="block enter" style={`--rkui-i: ${i}; background: var(${fill})`} />
        ))}
      </div>
    </Specimen>
  </SpecimenRow>

  <SpecimenRow title="Squash and settle">
    <Specimen label="1.3 × 0.7 on landing, 0.8 × 1.25 on take-off, 0.95 × 1.05 to settle, pinned to the ground (rkui-squash)">
      <div class="ground">
        <span class="ball bounce"></span>
      </div>
    </Specimen>
  </SpecimenRow>

  <SpecimenRow title="Reduced motion: loops stay still and fade instead (rkui-spinner-fade)">
    <Specimen label="the loop above" wide>
      <div class="track">
        <span class="block faded"></span>
      </div>
    </Specimen>
    <Specimen label="the bounce above">
      <div class="ground">
        <span class="ball faded"></span>
      </div>
    </Specimen>
  </SpecimenRow>
</Motion>

<style>
  /* What the tokens become under reduced motion, here at all times. Set on the button itself, as
     shadows.css declares the offsets on every element. */
  .reduced-input :global(.rkui-button) {
    --rkui-duration-fast: 0ms;
    --rkui-lift-offset: 0px;
    --rkui-press-offset: 0px;
  }

  .track {
    box-sizing: border-box;
    padding: var(--rkui-space-1);
    container-type: inline-size;
    border: var(--rkui-outline-width) solid var(--rkui-line-unfilled);
    border-radius: var(--rkui-radius);
  }

  .block {
    display: block;
    box-sizing: border-box;
    inline-size: 1.5rem;
    block-size: 1.5rem;
    border: var(--rkui-outline-width) solid var(--rkui-line);
    border-radius: calc(var(--rkui-radius) / 2);
    background: var(--rkui-yellow);
    box-shadow: var(--rkui-shadow);
  }

  /* Each move takes 15% of the loop. The easing applies to every step of the keyframes, but on the
     holds it has nothing to ease. */
  .hop {
    animation: motion-hop var(--rkui-loop-medium) var(--rkui-hop-ease) infinite;
  }

  @keyframes motion-hop {
    0%,
    35% {
      translate: 0 0;
    }

    50%,
    85% {
      translate: calc(100cqi - 100%) 0;
    }

    100% {
      translate: 0 0;
    }
  }

  .stagger {
    display: flex;
    gap: var(--rkui-space-3);
    padding-block: var(--rkui-space-2);
  }

  .enter {
    opacity: 0;
    animation: motion-enter var(--rkui-loop-panel) var(--rkui-ease-snap)
      calc(var(--rkui-i) * var(--rkui-stagger)) infinite backwards;
  }

  /* Comes in over 6% of the loop, holds, then fades out. */
  @keyframes motion-enter {
    0% {
      opacity: 0;
      translate: 0 0.75rem;
    }

    6%,
    75% {
      opacity: 1;
      translate: 0 0;
    }

    85%,
    100% {
      opacity: 0;
      translate: 0 0;
    }
  }

  .ground {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    inline-size: 6rem;
    block-size: 4.5rem;
    border-block-end: var(--rkui-outline-width) solid var(--rkui-line-unfilled);
  }

  /* A glint on the side the light comes from, opposite the shadow. */
  .ball {
    position: relative;
    box-sizing: border-box;
    inline-size: 1.75rem;
    block-size: 1.75rem;
    border: var(--rkui-outline-width) solid var(--rkui-line);
    border-radius: 50%;
    background: var(--rkui-coral);
    box-shadow: var(--rkui-shadow-pressed);
  }

  .ball::after {
    content: '';
    position: absolute;
    inset: 0;
    inline-size: 25%;
    block-size: 25%;
    margin: auto;
    border-radius: 50%;
    background: var(--rkui-glint);
    translate: calc(var(--rkui-shadow-dx) * -0.3rem) calc(var(--rkui-shadow-dy) * -0.3rem);
  }

  .bounce {
    transform-origin: 50% 100%;
    animation: rkui-squash var(--rkui-loop-short) infinite;
  }

  .faded {
    animation: rkui-spinner-fade 1.8s ease-in-out infinite alternate;
  }

  @media (prefers-reduced-motion: reduce) {
    .hop,
    .bounce {
      animation: rkui-spinner-fade 1.8s ease-in-out infinite alternate;
    }

    .enter {
      opacity: 1;
      animation: none;
    }
  }
</style>
