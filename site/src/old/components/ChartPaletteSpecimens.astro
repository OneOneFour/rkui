---
/** The chart colours: the series in their fixed order, and the sequential and diverging scales. */
import Specimen from './Specimen.astro'
import SpecimenRow from './SpecimenRow.astro'
import { DIVERGING, SEQUENTIAL, SEQUENTIAL_VIVID } from './chart-scale'
import './chart.css'

const SERIES = ['teal', 'yellow', 'navy', 'green', 'sky', 'coral', 'grape', 'tangerine']
---

<SpecimenRow title="Series, in order (--rkui-chart-1 to --rkui-chart-8)">
  <Specimen
    label="neighbours stay apart for colour-blind readers; scatter plots use the first three"
    wide
  >
    <ol class="steps">
      {SERIES.map((hue, i) => (
        <li>
          <span class="chip" style={`background: var(--rkui-chart-${i + 1})`} />
          {i + 1} {hue}
        </li>
      ))}
    </ol>
  </Specimen>
</SpecimenRow>

<SpecimenRow title="Scales">
  <Specimen label="A: navy sequential (--rkui-seq-1 to --rkui-seq-5): magnitude" wide>
    <ol class="steps">
      {SEQUENTIAL.map((step) => (
        <li>
          <span class="chip" style={`background: var(${step})`} />
          {step}
        </li>
      ))}
    </ol>
  </Specimen>
  <Specimen label="B: vivid sequential (--rkui-seq-vivid-1 to --rkui-seq-vivid-5)" wide>
    <ol class="steps">
      {SEQUENTIAL_VIVID.map((step) => (
        <li>
          <span class="chip" style={`background: var(${step})`} />
          {step}
        </li>
      ))}
    </ol>
  </Specimen>
  <Specimen
    label="diverging (--rkui-div-cold-3 to --rkui-div-warm-3): anomalies, neutral in the middle"
    wide
  >
    <ol class="steps">
      {DIVERGING.map((step) => (
        <li>
          <span class="chip" style={`background: var(${step})`} />
          {step}
        </li>
      ))}
    </ol>
  </Specimen>
</SpecimenRow>

<style>
  .steps {
    display: flex;
    flex-wrap: wrap;
    gap: var(--rkui-space-3);
    margin: 0;
    padding: 0;
    font-size: var(--rkui-step--1);
    list-style: none;
  }

  li {
    display: grid;
    justify-items: start;
    gap: var(--rkui-space-1);
  }

  .chip {
    inline-size: 4.5rem;
    block-size: 2rem;
    border-radius: calc(var(--rkui-radius) / 2);
  }
</style>
