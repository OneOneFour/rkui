---
/**
 * A titled row of styleguide examples (Specimens) that wraps on narrow screens.
 *
 * @param title the row's heading
 */
interface Props {
  title: string
}

const { title } = Astro.props
---

<h3>{title}</h3>
<div class="row">
  <slot />
</div>

<style>
  h3 {
    margin-block: var(--rkui-space-5) var(--rkui-space-3);
    font-size: var(--rkui-step-0);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    gap: var(--rkui-space-5);
  }
</style>
