---
/** Every button fill, size and style, and the filled and unfilled buttons in each state. */
import Button from '@oneonefour/rkui/components/button/Button.vue'
import Specimen from './Specimen.astro'
import SpecimenRow from './SpecimenRow.astro'
import PlayIcon from '@oneonefour/rkui/icons/play.svg'
import ResetIcon from '@oneonefour/rkui/icons/arrow-counter-clockwise.svg'
import DownloadIcon from '@oneonefour/rkui/icons/download-simple.svg'

const FILLS = [
  'navy',
  'teal',
  'green',
  'coral',
  'sky',
  'grape',
  'tangerine',
  'lilac',
  'apricot',
  'section',
] as const
const STATES = [
  { label: 'rest', class: '' },
  { label: 'hover', class: 'is-hover' },
  { label: 'pressed', class: 'is-active' },
  { label: 'focused', class: 'is-focus' },
]
---

<SpecimenRow title="Fills">
  <Specimen label="default (yellow)">
    <Button>Button</Button>
  </Specimen>
  {FILLS.map((fill) => (
    <Specimen label={fill}>
      <Button color={fill}>Button</Button>
    </Specimen>
  ))}
</SpecimenRow>

<SpecimenRow title="Sizes, icons and styles">
  <Specimen label="icon + label">
    <Button color="coral">
      <PlayIcon class="rkui-icon" />
      Start
    </Button>
  </Specimen>
  <Specimen label="small">
    <Button small color="teal">
      <PlayIcon class="rkui-icon rkui-icon--small" />
      Start
    </Button>
  </Specimen>
  <Specimen label="unfilled (secondary)">
    <Button unfilled>
      <ResetIcon class="rkui-icon" />
      Reset
    </Button>
  </Specimen>
  <Specimen label="small unfilled">
    <Button unfilled small>
      Reset
    </Button>
  </Specimen>
  <Specimen label="link (href)">
    <Button href="#buttons" color="navy">
      <DownloadIcon class="rkui-icon" />
      Download
    </Button>
  </Specimen>
</SpecimenRow>

<SpecimenRow title="Filled states">
  {STATES.map((state) => (
    <Specimen label={state.label}>
      <Button color="teal" class={state.class}>
        Button
      </Button>
    </Specimen>
  ))}
  <Specimen label="disabled">
    <Button color="teal" disabled>
      Button
    </Button>
  </Specimen>
  <Specimen label="focused, tangerine fill">
    <Button color="tangerine" class="is-focus">
      Button
    </Button>
  </Specimen>
</SpecimenRow>

<SpecimenRow title="Unfilled states">
  {STATES.map((state) => (
    <Specimen label={state.label}>
      <Button unfilled class={state.class}>
        Button
      </Button>
    </Specimen>
  ))}
  <Specimen label="disabled">
    <Button unfilled disabled>
      Button
    </Button>
  </Specimen>
</SpecimenRow>
