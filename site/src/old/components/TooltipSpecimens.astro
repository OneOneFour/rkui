---
/**
 * Tooltip options A and B, live and shown, and popups opened by a button (a panel and a
 * toggletip), live and as a static copy.
 *
 * @param theme the panel's theme, used to keep ids unique across the two panels
 */
import Button from '@oneonefour/rkui/components/button/Button.vue'
import Tooltip from '@oneonefour/rkui/components/tooltip/Tooltip.vue'
import Specimen from './Specimen.astro'
import SpecimenRow from './SpecimenRow.astro'
import CopyIcon from '@oneonefour/rkui/icons/copy.svg'
import InfoIcon from '@oneonefour/rkui/icons/info.svg'

interface Props {
  theme: 'light' | 'dark'
}

const { theme } = Astro.props
const SPECIMEN_TEXT =
  'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor.'
const OPTIONS = [
  { label: 'A: inverted', class: '', variant: 'inverted' as const },
  { label: 'B: toon', class: 'rkui-tooltip--toon', variant: 'toon' as const },
]
---

<SpecimenRow title="Tooltips: hover or focus the button">
  {OPTIONS.map((option, index) => (
    <Specimen label={option.label}>
      <Tooltip id={`${theme}-tip-${index}`} text="Tooltip text" variant={option.variant}>
        <Button aria-describedby={`${theme}-tip-${index}`}>Button</Button>
      </Tooltip>
    </Specimen>
  ))}
  {OPTIONS.map((option, index) => (
    <Specimen label={`${option.label}, icon button`}>
      <Tooltip id={`${theme}-icon-tip-${index}`} text={SPECIMEN_TEXT} variant={option.variant}>
        <Button color="teal" aria-describedby={`${theme}-icon-tip-${index}`}>
          <CopyIcon class="rkui-icon" />
          <span class="rkui-visually-hidden">Copy</span>
        </Button>
      </Tooltip>
    </Specimen>
  ))}
</SpecimenRow>

<SpecimenRow title="Tooltips: shown">
  {OPTIONS.map((option) => (
    <Specimen label={option.label}>
      <div class="room-above">
        <span class:list={['rkui-tooltip', 'is-hover', option.class]}>
          <Button tabindex="-1">Button</Button>
          <span class="rkui-tooltip-bubble">Tooltip text</span>
        </span>
      </div>
    </Specimen>
  ))}
  {OPTIONS.map((option) => (
    <Specimen label={`${option.label}, wrapping`}>
      <div class="room-above room-above--tall">
        <span class:list={['rkui-tooltip', 'is-hover', option.class]}>
          <Button tabindex="-1">Button</Button>
          <span class="rkui-tooltip-bubble">{SPECIMEN_TEXT}</span>
        </span>
      </div>
    </Specimen>
  ))}
</SpecimenRow>

<SpecimenRow title="Popups: click the button, Escape or a click outside closes">
  <Specimen label="panel">
    <Button popovertarget={`${theme}-popup`}>Open</Button>
    <div class="rkui-popup" id={`${theme}-popup`} popover>
      <p>{SPECIMEN_TEXT}</p>
      <Button small popovertarget={`${theme}-popup`} popovertargetaction="hide">
        Close
      </Button>
    </div>
  </Specimen>
  <Specimen label="toggletip">
    <Button small color="teal" popovertarget={`${theme}-toggletip`}>
      <InfoIcon class="rkui-icon rkui-icon--small" />
      <span class="rkui-visually-hidden">More information</span>
    </Button>
    <div class="rkui-popup" id={`${theme}-toggletip`} popover>
      <p>{SPECIMEN_TEXT}</p>
    </div>
  </Specimen>
  <Specimen label="static copy">
    <div class="rkui-popup">
      <p>{SPECIMEN_TEXT}</p>
      <Button small tabindex="-1">
        Close
      </Button>
    </div>
  </Specimen>
</SpecimenRow>

<style>
  /* The shown bubbles overhang their buttons, so give them room. */
  .room-above {
    display: flex;
    justify-content: center;
    min-inline-size: 16rem;
    padding-block-start: var(--rkui-space-7);
  }

  .room-above--tall {
    padding-block-start: calc(var(--rkui-space-8) + var(--rkui-space-5));
  }
</style>
