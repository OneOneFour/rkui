---
/**
 * The range slider in every state, the two ways it shows its value, and the tick mark variants.
 *
 * @param theme the panel's theme, used to keep ids unique across the two panels
 */
import Range from '@oneonefour/rkui/components/range/Range.vue'
import Specimen from './Specimen.astro'
import SpecimenRow from './SpecimenRow.astro'

interface Props {
  theme: 'light' | 'dark'
}

const { theme } = Astro.props
const STATES = [
  { label: 'rest', class: '' },
  { label: 'hover', class: 'is-hover' },
  { label: 'pressed', class: 'is-active' },
  { label: 'focused', class: 'is-focus' },
]
const TICKS = [0, 25, 50, 75, 100]
const TICK_STATES = [
  { label: 'rest', class: '' },
  { label: 'focused', class: 'is-focus' },
  { label: 'disabled', class: '', disabled: true },
]
---

<SpecimenRow title="Value display">
  <Specimen label="A: in the thumb" wide>
    <Range
      client:visible
      id={`${theme}-range-thumb`}
      label="Label"
      style="flex: 1"
      value-display="thumb"
      min="0"
      max="1"
      step="0.01"
      value="0.28"
    />
  </Specimen>
  <Specimen label="B: popup on hover, drag or focus" wide>
    <Range
      client:visible
      id={`${theme}-range-popup`}
      label="Label"
      style="flex: 1"
      value-display="popup"
      min="0"
      max="1"
      step="0.01"
      value="0.28"
    />
  </Specimen>
</SpecimenRow>

<SpecimenRow title="States">
  {STATES.map((state) => (
    <Specimen label={state.label} wide>
      <input class:list={['rkui-range', state.class]} type="range" aria-label="Specimen" />
    </Specimen>
  ))}
  <Specimen label="disabled" wide>
    <input class="rkui-range" type="range" aria-label="Specimen" disabled />
  </Specimen>
</SpecimenRow>

<SpecimenRow title="Ticks: tick row with labels (.rkui-range-scale)">
  {TICK_STATES.map((state, index) => (
    <Specimen label={state.label} wide>
      <div class="rkui-field">
        <input
          class:list={['rkui-range', state.class]}
          type="range"
          list={`${theme}-ticks-b-${index}`}
          step="25"
          aria-label="Specimen"
          disabled={state.disabled}
        />
        <datalist class="rkui-range-scale" id={`${theme}-ticks-b-${index}`}>
          {TICKS.map((tick) => (
            <option value={tick}>{tick}</option>
          ))}
        </datalist>
      </div>
    </Specimen>
  ))}
</SpecimenRow>
