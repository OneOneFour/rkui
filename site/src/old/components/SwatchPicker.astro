---
/**
 * A colour picker for the styleguide: the palette as colour tiles, optionally ending with the
 * custom colour tile.
 *
 * @param name the radios' name, unique on the page
 * @param flair a flair modifier class for the group, if any
 * @param custom end with the custom colour tile
 * @param checked the checked tile's value: a hue, or 'custom'
 * @param states static state classes by value, e.g. { navy: 'is-hover', custom: 'is-focus' }
 * @param disabled disable the whole group
 * @param paletteLegend show the legend, with a palette icon, instead of hiding it
 */
import PaletteIcon from '@oneonefour/rkui/icons/palette.svg'
import PaintBrushIcon from '@oneonefour/rkui/icons/paint-brush.svg'

interface Props {
  name: string
  flair?: string
  custom?: boolean
  checked?: string
  states?: Partial<Record<string, string>>
  disabled?: boolean
  paletteLegend?: boolean
}

const { name, flair, custom, checked = 'teal', states = {}, disabled, paletteLegend } = Astro.props
const HUES = [
  'navy',
  'teal',
  'coral',
  'yellow',
  'green',
  'sky',
  'grape',
  'tangerine',
  'lilac',
  'apricot',
]
// Hues that carry their own text colour; the rest take --rkui-on-fill.
const HUES_WITH_OWN_TEXT = ['navy', 'coral', 'grape']
// Only a group with a custom colour tile needs the script.
const Wrapper = custom ? 'rkui-color-picker' : Fragment

function swatchStyle(hue: string) {
  const onColor = HUES_WITH_OWN_TEXT.includes(hue) ? `--rkui-on-${hue}` : '--rkui-on-fill'
  return `--rkui-swatch: var(--rkui-${hue}); --rkui-swatch-on: var(${onColor})`
}
---

<Wrapper>
  <fieldset class:list={['rkui-tiles', flair]} disabled={disabled}>
    {paletteLegend ? (
      <legend>
        <PaletteIcon class="rkui-icon rkui-icon--small" aria-hidden="true" />
        Colour
      </legend>
    ) : (
      <legend class="rkui-visually-hidden">Colour</legend>
    )}
    {HUES.map((hue) => (
      <label class:list={['rkui-tile rkui-tile--color', states[hue]]} style={swatchStyle(hue)}>
        <input type="radio" name={name} value={hue} checked={hue === checked} />
        <span class="rkui-visually-hidden">{hue}</span>
      </label>
    ))}
    {custom && (
      <label class:list={['rkui-tile rkui-tile--custom-color', states.custom]}>
        <input
          type="radio"
          name={name}
          value="custom"
          checked={checked === 'custom'}
          aria-label="Custom colour"
        />
        <input type="color" aria-label="Choose custom colour" />
        <PaintBrushIcon aria-hidden="true" />
      </label>
    )}
  </fieldset>
</Wrapper>

<script>
  import '@oneonefour/rkui/components/color-picker/color-picker.js'
</script>
