---
import { SUMMARY, type SummaryText } from './color-summary'
import { defaultPalette } from './color-tokens'

/**
 * The core colours at a glance: one row per colour with a sample and the hex in each theme, its
 * permitted shades, and its text pair with the contrast in each theme. The hex and ratios are
 * read from the browser (show-colors.js), and the samples keep to the default palette and the
 * slab shadows.
 */

type Theme = 'light' | 'dark'
const THEMES: Theme[] = ['light', 'dark']

/** Inline style with a token as the background in one theme, and a recipe's inputs set. */
function paint(name: string, theme: Theme, inputs: Record<string, string> = {}) {
  const set = Object.entries(inputs).map(([input, token]) => `${input}: var(${token});`)
  return `color-scheme: ${theme}; ${set.join(' ')} background: var(${name});`
}

function textStyle(pair: SummaryText, theme: Theme) {
  return `${paint(pair.bg, theme)} color: var(${pair.fg});`
}

/** How the text column names a row's pair: the label token, or "on" the page for a text colour. */
function pairName(name: string, text: SummaryText) {
  return text.fg === name ? `on ${text.bg}` : text.fg
}
---

<div class="summary" data-palette={defaultPalette} data-shadow="slab">
  {SUMMARY.map((group) => (
    <>
      <h3>{group.title}</h3>
      <p class="caption">{group.caption}</p>
      <ul class="rows">
        {group.rows.map((row) => (
          <li class="row" data-readout>
            <code class="name">{row.color.label}</code>
            {THEMES.map((theme) => (
              <span class={`theme ${theme}`}>
                <span
                  class="chip"
                  data-sample={`chip-${theme}`}
                  data-palette={row.color.palette}
                  style={paint(row.color.name, theme, row.color.inputs)}
                />
                <span class="hex">
                  {theme} <output data-show="hex-background" data-of={`chip-${theme}`} />
                </span>
              </span>
            ))}
            {row.shades.length > 0 && (
              <ul class="shades">
                {row.shades.map((shade, i) => (
                  <li class="shade">
                    <span class="mini" data-palette={shade.palette}>
                      {THEMES.map((theme) => (
                        <span
                          data-sample={`shade-${i}-${theme}`}
                          style={paint(shade.name, theme, shade.inputs)}
                        />
                      ))}
                    </span>
                    <span class="hex">
                      <code>{shade.label}</code>{' '}
                      <output data-show="hex-background" data-of={`shade-${i}-light`} /> /{' '}
                      <output data-show="hex-background" data-of={`shade-${i}-dark`} />
                    </span>
                  </li>
                ))}
              </ul>
            )}
            {row.text && (
              <span class="text">
                <span class="sample" data-palette={row.text.palette}>
                  {THEMES.map((theme) => (
                    <span data-sample={`text-${theme}`} style={textStyle(row.text!, theme)}>
                      Aa
                    </span>
                  ))}
                </span>
                <span class="hex">
                  <code>{pairName(row.color.name, row.text)}</code>{' '}
                  <output data-show="ratio" data-digits="1" data-of="text-light" /> /{' '}
                  <output data-show="ratio" data-digits="1" data-of="text-dark" />
                </span>
              </span>
            )}
          </li>
        ))}
      </ul>
    </>
  ))}
</div>

<script>
  import './show-colors'
</script>

<style>
  .summary {
    container-type: inline-size;
  }

  h3 {
    margin-block: var(--rkui-space-5) var(--rkui-space-2);
    font-size: var(--rkui-step-1);
  }

  .caption {
    max-width: 65ch;
    margin-block: 0 var(--rkui-space-3);
    color: var(--rkui-muted);
    font-size: var(--rkui-step--1);
  }

  .rows,
  .shades {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Narrow: the name across the top, then the two themes, the shades and the text pair. */
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-areas:
      'name name'
      'light dark'
      'shades shades'
      'text text';
    gap: var(--rkui-space-2) var(--rkui-space-3);
    padding-block: var(--rkui-space-3);
    border-block-start: 1px solid var(--rkui-muted);
    font-size: var(--rkui-step--1);
    font-variant-numeric: tabular-nums;
  }

  .name {
    grid-area: name;
    font-weight: 700;
  }

  .theme {
    display: flex;
    align-items: center;
    gap: var(--rkui-space-2);
  }

  .light {
    grid-area: light;
  }

  .dark {
    grid-area: dark;
  }

  .shades {
    display: flex;
    flex-wrap: wrap;
    grid-area: shades;
    gap: var(--rkui-space-1) var(--rkui-space-3);
  }

  .shade,
  .text {
    display: flex;
    align-items: center;
    gap: var(--rkui-space-2);
  }

  .text {
    grid-area: text;
  }

  .chip,
  .mini,
  .sample {
    flex: none;
    overflow: hidden;
    border: 1px solid var(--rkui-muted);
    border-radius: var(--rkui-radius);
  }

  .chip {
    inline-size: 2.5rem;
    block-size: 2rem;
  }

  /* Split samples: the light theme on the left, the dark on the right. */
  .mini,
  .sample {
    display: flex;
  }

  .mini > span {
    inline-size: 0.875rem;
    block-size: 1.25rem;
  }

  .sample > span {
    padding: var(--rkui-space-1) var(--rkui-space-2);
    font-family: var(--rkui-font-display);
    font-weight: 800;
  }

  /* Wide: one line per colour. */
  @container (width >= 56rem) {
    .row {
      grid-template-columns: 9rem 9rem 9rem 1fr 15rem;
      grid-template-areas: 'name light dark shades text';
      align-items: center;
    }
  }
</style>
