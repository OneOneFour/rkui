---
/**
 * Sticky notes: static note cards in every hue, note and warning prompts, a linked note card in
 * each state, and the tilt, tape and pin options.
 */
import Card from '@oneonefour/rkui/components/card/Card.vue'
import Callout from '@oneonefour/rkui/components/callout/Callout.vue'
import Specimen from './Specimen.astro'
import SpecimenRow from './SpecimenRow.astro'
import ImageIcon from '@oneonefour/rkui/icons/image.svg'

const HUES = ['sky', 'tangerine', 'green', 'coral', 'grape', 'lilac', 'apricot']
const STATES = [
  { label: 'hover (the corner lifts)', class: 'is-hover' },
  { label: 'pressed', class: 'is-active' },
  { label: 'focused', class: 'is-focus' },
]
---

<SpecimenRow title="Colours">
  <Specimen label="default (yellow)" wide>
    <Card title="Card title" class="rkui-sticky-note">
      <p>Body text. Pack my box with five dozen liquor jugs.</p>
    </Card>
  </Specimen>
  {HUES.map((hue) => (
    <Specimen label={hue} wide>
      <Card title="Card title" class={`rkui-sticky-note rkui-sticky-note--${hue}`}>
        <p>Body text. Pack my box with five dozen liquor jugs.</p>
      </Card>
    </Specimen>
  ))}
</SpecimenRow>

<SpecimenRow title="Prompts">
  <Specimen label="note callout (sky)" wide>
    <Callout title="Title" class="rkui-sticky-note">
      <p>
        Body text with <a href="#sticky-notes">a link</a>. Pack my box with five dozen liquor jugs.
      </p>
    </Callout>
  </Specimen>
  <Specimen label="warning callout (tangerine)" wide>
    <Callout kind="warning" title="Title" class="rkui-sticky-note">
      <p>
        Body text with <a href="#sticky-notes">a link</a>. Pack my box with five dozen liquor jugs.
      </p>
    </Callout>
  </Specimen>
  <Specimen label="warning, focused link (--rkui-focus-alt)" wide>
    <Callout kind="warning" class="rkui-sticky-note">
      <p>
        Body text with{' '}
        <a href="#sticky-notes" class="is-focus">
          a focused link
        </a>
        .
      </p>
    </Callout>
  </Specimen>
  <Specimen label="note callout, yellow" wide>
    <Callout class="rkui-sticky-note rkui-sticky-note--yellow">
      <p>Body text. Sphinx of black quartz, judge my vow.</p>
    </Callout>
  </Specimen>
</SpecimenRow>

<SpecimenRow title="Linked note card">
  <Specimen label="rest" wide>
    <Card title="Card title" href="#sticky-notes" meta="Meta line" class="rkui-sticky-note">
      <p>Body text.</p>
    </Card>
  </Specimen>
  {STATES.map((state) => (
    <Specimen label={state.label} wide>
      <Card
        title="Card title"
        href="#sticky-notes"
        meta="Meta line"
        class={`rkui-sticky-note ${state.class}`}
      >
        <p>Body text.</p>
      </Card>
    </Specimen>
  ))}
  <Specimen label="with image" wide>
    <Card
      title="Card title"
      href="#sticky-notes"
      meta="Meta line"
      class="rkui-sticky-note rkui-sticky-note--green"
    >
      <div slot="image" class="rkui-card-image image-placeholder">
        <ImageIcon class="rkui-icon" />
      </div>
      <p>Body text.</p>
    </Card>
  </Specimen>
</SpecimenRow>

<SpecimenRow title="Options">
  <Specimen label="tilt" wide>
    <Card title="Card title" class="rkui-sticky-note rkui-sticky-note--tilt">
      <p>Body text. The quick brown fox jumps over the lazy dog.</p>
    </Card>
  </Specimen>
  <Specimen label="tilt, --rkui-note-tilt: 1.5deg" wide>
    <article
      class="rkui-card rkui-sticky-note rkui-sticky-note--grape rkui-sticky-note--tilt"
      style="--rkui-note-tilt: 1.5deg"
    >
      <div class="rkui-card-body">
        <h3 class="rkui-card-title">Card title</h3>
        <p>Body text. The quick brown fox jumps over the lazy dog.</p>
      </div>
    </article>
  </Specimen>
  <Specimen label="tape" wide>
    <Card title="Card title" class="rkui-sticky-note rkui-sticky-note--tape">
      <p>Body text. The quick brown fox jumps over the lazy dog.</p>
    </Card>
  </Specimen>
  <Specimen label="pin" wide>
    <Card title="Card title" class="rkui-sticky-note rkui-sticky-note--coral rkui-sticky-note--pin">
      <p>Body text. The quick brown fox jumps over the lazy dog.</p>
    </Card>
  </Specimen>
  <Specimen label="warning, tilt and tape" wide>
    <Callout
      kind="warning"
      title="Title"
      class="rkui-sticky-note rkui-sticky-note--tilt rkui-sticky-note--tape"
    >
      <p>Body text. Sphinx of black quartz, judge my vow.</p>
    </Callout>
  </Specimen>
</SpecimenRow>

<style>
  .image-placeholder {
    display: grid;
    place-items: center;
    background: var(--rkui-teal-tint);
    --rkui-icon-fill: var(--rkui-teal);
  }

  .image-placeholder :global(.rkui-icon) {
    inline-size: 3rem;
    block-size: 3rem;
  }
</style>
