---
/**
 * Renders every docs page in src/content/docs/ with the docs layout. A Markdown `>` quote renders
 * as rkui's Quote; rkui's Astro integration renders fenced code (astro.config.js).
 */
import { render } from 'astro:content'
import Quote from '@oneonefour/rkui/components/quote/Quote.vue'
import DocsLayout from '../layouts/DocsLayout.astro'
import { sortedPages, type DocsPage } from '../lib/pages'

export async function getStaticPaths() {
  const pages = await sortedPages()
  return pages.map((page) => ({
    // index.mdx has no slug, so it is the home page.
    params: { slug: page.id === 'index' ? undefined : page.id },
    props: { page },
  }))
}

interface Props {
  page: DocsPage
}

const { page } = Astro.props
const { Content } = await render(page)
---

<DocsLayout page={page}>
  <Content components={{ blockquote: Quote }} />
</DocsLayout>
