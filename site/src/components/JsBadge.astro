---
/**
 * When an Astro page gives a component `client:visible`, as a badge (interactive-components.js):
 * "Needs client:visible", or with the options that need it. Nothing when it never does.
 *
 * @param component the component's name, e.g. 'Range'
 */
import Badge from '@oneonefour/rkui/components/badge/Badge.vue'
import { clientVisibleWhen } from '../lib/interactive-components.js'

interface Props {
  component: string
}

const { component } = Astro.props
const when = clientVisibleWhen(component)
---

{when !== undefined && (
  <Badge hue="grape">{when ? `Needs client:visible ${when}` : 'Needs client:visible'}</Badge>
)}
