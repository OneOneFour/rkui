---
/**
 * One badge for each of the library's helper scripts a component uses (helper-scripts.js), named
 * by its file and linking to the setup section. Nothing when the component uses none.
 *
 * @param component the component's name, e.g. 'Scroll'
 */
import Badge from '@oneonefour/rkui/components/badge/Badge.vue'
import { helpersFor } from '../lib/helper-scripts.js'
import { link } from '../lib/pages'

interface Props {
  component: string
}

const { component } = Astro.props
---

{helpersFor(component).map((script) => (
  <a class="docs-chip-link" href={link('#helper-scripts')}>
    <Badge>{script}</Badge>
  </a>
))}
