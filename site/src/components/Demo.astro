---
/**
 * A live demo in folder tabs. Most demos are written inline, as an Astro page writes them, with
 * one import per component at the top of the page; a component that runs in the browser gets
 * `client:visible` on its own tag. At build time demo-source.js copies the text inside the Demo
 * into `astro`, as an Astro page with those imports:
 *
 *   import Stepper from '@oneonefour/rkui/components/number/Stepper.vue'
 *
 *   <Demo label="Split stepper">
 *     <Stepper client:visible label="Quantity" value="3" />
 *   </Demo>
 *
 * A demo that needs a `.vue` file (a widget, script logic or its own `<style>`) lives in
 * src/examples/ and is imported twice: as a component for the slot, and with `?raw` for `vue`.
 * A demo that runs in the browser gets `client:visible`, which makes the whole demo one island.
 *
 *   import Lift from '../../examples/logo/Lift.vue'
 *   import liftCode from '../../examples/logo/Lift.vue?raw'
 *
 *   <Demo vue={liftCode} label="Logo lift"><Lift /></Demo>
 *
 * The tabs:
 * - Preview: the slot, rendered.
 * - Astro: an inline demo's source, formatted with Prettier. For a `.vue` file, the same demo
 *   written for an Astro page (astro-source.js), with `client:visible` on each component that
 *   runs in the browser; such a demo must itself get `client:visible`, or the build stops.
 * - Vue: a `.vue` file's source. For an inline demo, the same demo written as a Vue file
 *   (vue-source.js), which stops the build if a component's `client:visible` is missing or not
 *   needed.
 * - HTML: what a plain HTML page writes: the markup the demo renders, formatted with Prettier,
 *   followed by the imports of the element scripts it uses. In a demo that runs in the browser, a
 *   component with a custom element for plain pages, such as Stepper, is written as that element
 *   (plain-render.js); one without, such as CodeBlock, shows the markup it renders on the server.
 *
 * A `widget` demo uses Vue's reactivity, events or Vue-only components (WidgetTabs), and has no
 * Astro or plain-HTML form, so it shows only Preview and Vue. A demo that isn't marked `widget`
 * but can't be written for Astro stops the build.
 *
 * The preview lays its contents out in a wrapping row, or in a column with `stack`.
 *
 * @param astro an inline demo's source, as an Astro page, from demo-source.js
 * @param vue the text of a demo's `.vue` file; a Demo has this or `astro`
 * @param label what the demo shows, naming its tabs for screen readers
 * @param stack lays the preview out in a column, for text and other wide things
 * @param widget the demo is a Vue widget with no Astro or plain-HTML form
 */
import CodeBlock from '@oneonefour/rkui/components/code/CodeBlock.vue'
import Tab from '@oneonefour/rkui/components/folder/Tab.vue'
import Tabs from '@oneonefour/rkui/components/folder/Tabs.vue'
import { astroSource } from '../lib/astro-source.js'
import { scriptsFor } from '../lib/element-scripts.js'
import { formatCode } from '../lib/format-code.js'
import { checkImportNames } from '../lib/library-imports.js'
import { plainRender, usesElement } from '../lib/plain-render.js'
import { useSprite } from '../lib/icon-sprite.js'
import { vueSource } from '../lib/vue-source.js'

interface Props {
  astro?: string
  vue?: string
  label: string
  stack?: boolean
  widget?: boolean
}

const { astro, vue, label, stack = false, widget = false } = Astro.props
const rendered = await Astro.slots.render('default')
const interactive = rendered.includes('<astro-island')

/**
 * The demo's markup as a plain HTML page would write it: no Astro or Vue attributes & none of Vue's markers
 */
async function readableHtml(html: string): Promise<string> {
  const markup = useSprite(
    html
      .replace(/<script\b[\s\S]*?<\/script>/g, '')
      .replace(/<style\b[\s\S]*?<\/style>/g, '')
      .replace(/<!--(\[|\]|v-if|astro:end)?-->/g, '')
      .replace(/<\/?astro-static-slot>/g, '')
      .replace(/\s+data-(astro|v)-[\w-]+(="[^"]*")?/g, '')
      .replace(/\s+(style|class)=""/g, '')
      .replace(/<svg\b[^>]*>/g, (svg) => svg.replace(' viewbox=', ' viewBox=')),
  )
  const scripts = scriptsFor(markup)
  const page = scripts.length
    ? `${markup}\n<script type="module">\n${scripts.map((script) => `import '${script}'`).join('\n')}\n</script>`
    : markup
  return formatCode(page, 'html', { htmlWhitespaceSensitivity: 'ignore' })
}

/** The Astro and Vue tabs' code. A widget has no Astro tab. */
async function sourceTabs(): Promise<{ astro?: string; vue: string }> {
  if (astro && !vue) {
    checkImportNames(astro)
    return { astro: await formatCode(astro, 'astro'), vue: await vueSource(astro) }
  }
  if (!vue || astro) throw new Error('Give it a .vue file as vue={…}, or write the demo inside it')
  checkImportNames(vue)
  if (widget) return { vue: vue.trim() }
  const astroCode = await astroSource(vue)
  if (astroCode.includes(' client:visible') && !interactive) {
    throw new Error('It uses a component that runs in the browser; give it client:visible')
  }
  return { astro: astroCode, vue: vue.trim() }
}

/**
 * The markup a plain page writes for the demo, before readableHtml tidies it. A component with a
 * custom element is written as that element; anything else is what the preview renders.
 */
async function plainMarkup(vueCode: string): Promise<string> {
  if (interactive && usesElement(vueCode)) return plainRender(vueCode)
  return rendered.replace(/<astro-island\b[^>]*>([\s\S]*?)<\/astro-island>/g, '$1')
}

let astroCode: string | undefined
let vueCode: string
let html: string | undefined
try {
  const tabs = await sourceTabs()
  astroCode = tabs.astro
  vueCode = tabs.vue
  html = widget ? undefined : await readableHtml(await plainMarkup(vueCode))
} catch (error) {
  throw new Error(`Demo "${label}": ${(error as Error).message}`)
}
---

<Tabs label={label} class="demo">
  <Tab label="Preview">
    <div class:list={['preview', { 'preview--stack': stack }]}>
      <Fragment set:html={rendered} />
    </div>
  </Tab>
  {astroCode && (
    <Tab label="Astro">
      <CodeBlock client:visible code={astroCode} lang="astro" />
    </Tab>
  )}
  <Tab label="Vue">
    <CodeBlock client:visible code={vueCode} lang="vue" />
  </Tab>
  {html && (
    <Tab label="HTML">
      <CodeBlock client:visible code={html} lang="html" />
    </Tab>
  )}
</Tabs>

<style>
  .demo {
    margin-block: var(--rkui-space-5);
  }

  /* With the sheet's own padding, 2rem above and below the preview and 1.5rem either side. */
  .preview {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--rkui-space-4);
    padding: var(--rkui-space-4) var(--rkui-space-2);
  }

  .preview--stack {
    flex-direction: column;
    align-items: stretch;
  }
</style>
