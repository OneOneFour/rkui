---
/**
 * The colours as a palette picker: a tall column per hue with its -deep and -tint steps beneath,
 * the core hues, a row of page colours, then the auxiliary hues with their jobs. Each block is a
 * button that copies its colour, as a hex or as `var(--rkui-…)`, chosen by the switch above. The
 * hexes are read from what the browser paints, so they follow the theme, palette, shadow and
 * highlight.
 *
 * Text on each block follows the on-colour rule: a fill's own label token; the page colour on a
 * -deep step (a deep step is text on the page, so the page colour reads on it); body text on a
 * tint; body text on a panel. Translucent shading is shown over the page colour, and its hex is that
 * mix. The fills' text is large, because bright coral passes with white only at that size.
 */
import Segmented from '@oneonefour/rkui/components/segmented/Segmented.vue'
import SegmentedOption from '@oneonefour/rkui/components/segmented/SegmentedOption.vue'
import { onHue, type Hue } from '@oneonefour/rkui/shared/hues.ts'
import Swatch from './Swatch.astro'

/** A colour block: the token it shows and the token its text is set in, both without `--rkui-`. */
interface Swatch {
  token: string
  text: string
}

const CORE: Hue[] = ['navy', 'teal', 'coral', 'yellow', 'green', 'sky']

/** The auxiliary hues and the jobs each one does. */
const AUXILIARY: { hue: Hue; job: string }[] = [
  { hue: 'grape', job: 'Interactive accents, code and maths highlights' },
  { hue: 'lilac', job: 'Widget frames, equation pills' },
  { hue: 'tangerine', job: 'Warnings, work in progress, focus' },
  { hue: 'apricot', job: 'Marked text, callouts, the target flash' },
]

/** A hue's fill, -deep and -tint blocks, top to bottom. */
function column(hue: Hue): Swatch[] {
  return [
    { token: hue, text: onHue(hue).replace('--rkui-', '') },
    { token: `${hue}-deep`, text: 'surface' },
    { token: `${hue}-tint`, text: 'fg' },
  ]
}

const NEUTRALS: Swatch[] = [
  { token: 'surface', text: 'fg' },
  { token: 'raised', text: 'fg' },
  { token: 'fg', text: 'surface' },
  { token: 'muted', text: 'surface' },
  { token: 'line', text: 'on-ink' },
]

/** The panel and shading colours, each with what uses it. */
const PANELS: { token: string; job: string }[] = [
  { token: 'slate', job: 'Code blocks, quotes, nested quotes' },
  { token: 'slate-tab', job: "The code block's editor-tab strip" },
  { token: 'slate-greige', job: 'The greige alternative to slate' },
  { token: 'slate-greige-tab', job: 'The greige alternative to the tab strip' },
  { token: 'folder-back', job: "Unselected folder tabs, a drawer's tray, an inset card" },
  { token: 'recess', job: "The shadow inside a drawer's tray and an inset card (translucent)" },
  { token: 'stripe', job: "The code panel's inset, hatching (translucent)" },
]

/** The syntax colours, with the kind of code each one sets. */
const CODE: { token: string; job: string }[] = [
  { token: 'code-keyword', job: 'Keywords' },
  { token: 'code-string', job: 'Strings' },
  { token: 'code-number', job: 'Numbers' },
  { token: 'code-function', job: 'Function names' },
  { token: 'code-comment', job: 'Comments' },
]
---

<div class="color-palette">
  <Segmented legend="Copy colours as" class="copy-as">
    <SegmentedOption value="hex" checked>
      Copy hex
    </SegmentedOption>
    <SegmentedOption value="var">Copy var(--rkui-…)</SegmentedOption>
  </Segmented>

  <div class="hues">
    {CORE.map((hue) => (
      <div class="column">
        {column(hue).map(({ token, text }) => (
          <Swatch token={token} text={text} />
        ))}
      </div>
    ))}
  </div>

  <div class="neutrals">
    {NEUTRALS.map(({ token, text }) => (
      <Swatch token={token} text={text} />
    ))}
  </div>

  <div class="auxiliary">
    <h2>Auxiliary colours</h2>
    <div class="hues">
      {AUXILIARY.map(({ hue, job }) => (
        <div class="column">
          {column(hue).map(({ token, text }) => (
            <Swatch token={token} text={text} />
          ))}
          <p class="job">{job}</p>
        </div>
      ))}
    </div>
  </div>

  <div class="auxiliary">
    <h2>Panels and shading</h2>
    <p class="note">
      Recess and stripe are translucent recipes, the outline colour over whatever they cross. They
      are shown over the page colour.
    </p>
    <div class="hues">
      {PANELS.map(({ token, job }) => (
        <div class="column panel">
          <Swatch token={token} text="fg" />
          <p class="job">{job}</p>
        </div>
      ))}
    </div>
  </div>

  <div class="auxiliary">
    <h2>Code colours</h2>
    <div class="hues">
      {CODE.map(({ token, job }) => (
        <div class="column panel">
          <Swatch token={token} text="surface" />
          <p class="job">{job}</p>
        </div>
      ))}
    </div>
    <div class="samples">
      <pre class="sample slate"><code><span class="kw">const</span> total = <span class="fn">add</span>(<span class="num">2</span>, <span class="str">'3'</span>) <span class="cm">// slate</span></code></pre>
      <pre class="sample greige"><code><span class="kw">const</span> total = <span class="fn">add</span>(<span class="num">2</span>, <span class="str">'3'</span>) <span class="cm">// slate-greige</span></code></pre>
    </div>
  </div>

  <p class="rkui-visually-hidden" aria-live="polite"></p>
</div>

<style>
  .color-palette {
    --palette-gap: calc(var(--rkui-depth-gap-scale) * var(--rkui-space-3));

    display: grid;
    gap: var(--rkui-space-5);
    margin-block: var(--rkui-space-5);
  }

  .copy-as {
    justify-self: start;
  }

  .hues {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
    gap: var(--palette-gap);
  }

  .column {
    display: grid;
    grid-template-rows: 10rem 5rem 5rem;
    gap: var(--palette-gap);
  }

  .auxiliary .column {
    grid-template-rows: 10rem 5rem 5rem auto;
  }

  .auxiliary .column.panel {
    grid-template-rows: 7rem auto;
  }

  .note {
    margin: 0 0 var(--palette-gap);
  }

  .samples {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--palette-gap);
    margin-block-start: var(--palette-gap);
  }

  .sample {
    margin: 0;
    padding: var(--rkui-space-3);
    overflow-x: auto;
    color: var(--rkui-fg);
    font-family: var(--rkui-font-mono);
    font-size: var(--rkui-step--1);
  }

  .sample.slate {
    background: var(--rkui-slate);
  }

  .sample.greige {
    background: var(--rkui-slate-greige);
  }

  .kw {
    color: var(--rkui-code-keyword);
  }

  .fn {
    color: var(--rkui-code-function);
  }

  .str {
    color: var(--rkui-code-string);
  }

  .num {
    color: var(--rkui-code-number);
  }

  .cm {
    color: var(--rkui-code-comment);
  }

  .job {
    margin: 0;
    color: var(--rkui-muted);
    font-size: var(--rkui-step--1);
  }

  .neutrals {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
    grid-auto-rows: 5rem;
    gap: var(--palette-gap);
  }

  .column > :global(.swatch:first-child) {
    font-size: var(--rkui-step-1);
  }
</style>

<script>
  const ATTRIBUTES = ['data-theme', 'data-palette', 'data-shadow', 'data-highlight']
  const COPIED_FOR = 1200

  let context: OffscreenCanvasRenderingContext2D | null | undefined

  /** Any colour the browser can paint, as `#rrggbb`, over the page colour: painted on a 1 by 1 canvas and read back. */
  function toHex(cssColor: string): string {
    context ??= new OffscreenCanvas(1, 1).getContext('2d', { willReadFrequently: true })
    if (!context) return ''
    context.clearRect(0, 0, 1, 1)
    context.fillStyle = getComputedStyle(document.body).backgroundColor
    context.fillRect(0, 0, 1, 1)
    context.fillStyle = cssColor
    context.fillRect(0, 0, 1, 1)
    const [r, g, b] = context.getImageData(0, 0, 1, 1).data
    return '#' + [r, g, b].map((byte) => byte.toString(16).padStart(2, '0')).join('')
  }

  /** The block's colour as the browser paints it now. */
  function hexOf(swatch: HTMLElement): string {
    return toHex(getComputedStyle(swatch).backgroundColor)
  }

  for (const palette of document.querySelectorAll<HTMLElement>('.color-palette')) {
    const swatches = [...palette.querySelectorAll<HTMLButtonElement>('.swatch')]
    const announcer = palette.querySelector('[aria-live]')
    /** The timer that ends each block's "Copied" state. */
    const copiedTimers = new Map<HTMLElement, number>()

    /** Shows each block's hex, except on a block showing "Copied". */
    const showHexes = () => {
      for (const swatch of swatches) {
        const value = swatch.querySelector('.value')
        if (value && !copiedTimers.has(swatch)) value.textContent = hexOf(swatch)
      }
    }

    const copy = async (swatch: HTMLButtonElement) => {
      const asVar = palette.querySelector<HTMLInputElement>('input[value="var"]')?.checked
      const text = asVar ? `var(--rkui-${swatch.dataset.token})` : hexOf(swatch)
      try {
        await navigator.clipboard.writeText(text)
      } catch {
        if (announcer) announcer.textContent = `Couldn't copy ${text}`
        return
      }
      if (announcer) announcer.textContent = `Copied ${text}`

      const value = swatch.querySelector('.value')
      if (value) value.textContent = 'Copied'
      clearTimeout(copiedTimers.get(swatch))
      const timer = setTimeout(() => {
        copiedTimers.delete(swatch)
        showHexes()
      }, COPIED_FOR)
      copiedTimers.set(swatch, timer)
    }

    for (const swatch of swatches) swatch.addEventListener('click', () => copy(swatch))
    showHexes()
    new MutationObserver(showHexes).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ATTRIBUTES,
    })
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', showHexes)
  }
</script>
