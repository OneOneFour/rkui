---
/**
 * The list of docs pages, built from the docs collection: pages grouped by their `group` and
 * sorted by `order`, in rkui's Sidebar. A group sits where its first page sits. A page marked
 * `new` gets a tilted "New!" badge in its link's corner.
 *
 * @example
 * <Sidebar current={page.id} label="Pages" />
 */
import Badge from '@oneonefour/rkui/components/badge/Badge.vue'
import RkuiSidebar from '@oneonefour/rkui/components/sidebar/Sidebar.vue'
import SidebarGroup from '@oneonefour/rkui/components/sidebar/SidebarGroup.vue'
import SidebarLink from '@oneonefour/rkui/components/sidebar/SidebarLink.vue'
import { pageUrl, sortedPages, type DocsPage } from '../lib/pages'

interface Props {
  /** The id of the page being shown, marked as the current page. */
  current: string
  /** The navigation's accessible name; two sidebars on a page need different ones. */
  label: string
}

const { current, label } = Astro.props

const groups = new Map<string, DocsPage[]>()
for (const page of await sortedPages()) {
  const pages = groups.get(page.data.group) ?? []
  pages.push(page)
  groups.set(page.data.group, pages)
}
---

<RkuiSidebar label={label}>
  {[...groups].map(([group, pages]) => (
    <SidebarGroup heading={group}>
      {pages.map((page) => (
        <SidebarLink href={pageUrl(page)} current={page.id === current}>
          {page.data.title}
          {page.data.new && (
            <Badge hue="coral" class="docs-new">
              New!
            </Badge>
          )}
        </SidebarLink>
      ))}
    </SidebarGroup>
  ))}
</RkuiSidebar>
