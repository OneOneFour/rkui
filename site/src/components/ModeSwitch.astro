---
/**
 * A docs-site switch for a mode on <html>, under its name: checking an option sets `data-<name>`
 * and remembers it under `rkui-<name>`. DocsLayout restores the stored choice before first paint.
 */
import Segmented from '@oneonefour/rkui/components/segmented/Segmented.vue'
import SegmentedOption from '@oneonefour/rkui/components/segmented/SegmentedOption.vue'

interface Option {
  value: string
  label: string
}

interface Props {
  /** The mode: `palette`, `shadow` or `highlight`. */
  name: 'palette' | 'shadow' | 'highlight'
  /** The switch's name, shown above it. */
  legend: string
  /** A line after the name, such as when the mode shows; none when left out. */
  note?: string
  /** The choices; the first is the default. */
  options: Option[]
}

const { name, legend, note, options } = Astro.props
// No radio starts checked: the script checks the stored choice, so the sliding pill starts there.
---

<div class="docs-mode">
  <p class="docs-mode-name" aria-hidden="true">
    {legend} {note && <span class="docs-mode-note">{note}</span>}
  </p>
  <Segmented legend={note ? `${legend}, ${note}` : legend} name={`rkui-${name}`} data-mode={name}>
    {options.map(({ value, label }) => (
      <SegmentedOption value={value}>{label}</SegmentedOption>
    ))}
  </Segmented>
</div>

<script>
  import { afterSlide } from '@oneonefour/rkui/shared/after-slide.js'

  const root = document.documentElement

  for (const fieldset of document.querySelectorAll<HTMLElement>('fieldset[data-mode]')) {
    const name = fieldset.dataset.mode ?? ''
    const radios = [...fieldset.querySelectorAll('input')]
    // The stored choice, or the default where there is none or it is no longer an option.
    const current = radios.find((radio) => radio.value === root.dataset[name]) ?? radios[0]

    for (const radio of radios) {
      radio.checked = radio === current
      radio.addEventListener('change', () => {
        afterSlide(radio, () => (root.dataset[name] = radio.value))
        try {
          localStorage.setItem(`rkui-${name}`, radio.value)
        } catch {
          // Storage is blocked, so the choice lasts only until the page is left.
        }
      })
    }
  }
</script>
