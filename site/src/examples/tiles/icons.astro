---
import Tiles from '@oneonefour/rkui/components/tiles/Tiles.astro'
import Tile from '@oneonefour/rkui/components/tiles/Tile.astro'
import Sun from '@oneonefour/rkui/icons/sun.svg'
import Cloud from '@oneonefour/rkui/icons/cloud.svg'
import CloudRain from '@oneonefour/rkui/icons/cloud-rain.svg'
import CloudLightning from '@oneonefour/rkui/icons/cloud-lightning.svg'
import Wind from '@oneonefour/rkui/icons/wind.svg'
---

<Tiles legend="Weather" multiple>
  <Tile value="sun">
    <Sun slot="icon" />
    Sun
  </Tile>
  <Tile value="cloud" checked>
    <Cloud slot="icon" />
    Cloud
  </Tile>
  <Tile value="cloud-rain">
    <CloudRain slot="icon" />
    Cloud rain
  </Tile>
  <Tile value="cloud-lightning">
    <CloudLightning slot="icon" />
    Cloud lightning
  </Tile>
  <Tile value="wind">
    <Wind slot="icon" />
    Wind
  </Tile>
</Tiles>
