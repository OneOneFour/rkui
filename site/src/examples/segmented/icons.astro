---
import Segmented from '@oneonefour/rkui/components/segmented/Segmented.astro'
import SegmentedOption from '@oneonefour/rkui/components/segmented/SegmentedOption.astro'
import Sun from '@oneonefour/rkui/icons/sun.svg'
import Moon from '@oneonefour/rkui/icons/moon.svg'
import CircleHalf from '@oneonefour/rkui/icons/circle-half.svg'
---

<Segmented legend="Choice">
  <SegmentedOption value="one" checked>
    <Sun slot="icon" />
    One
  </SegmentedOption>
  <SegmentedOption value="two">
    <Moon slot="icon" />
    Two
  </SegmentedOption>
  <SegmentedOption value="three">
    <CircleHalf slot="icon" />
    Three
  </SegmentedOption>
</Segmented>
