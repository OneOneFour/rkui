---
import Button from '@oneonefour/rkui/components/button/Button.astro'
import Tooltip from '@oneonefour/rkui/components/tooltip/Tooltip.astro'
---

<div class="room-above">
  <Tooltip id="tooltip-save" text="Save the file">
    <Button aria-describedby="tooltip-save">Save</Button>
  </Tooltip>
</div>

<style>
  /* The bubble opens above its button, so leave room for it. */
  .room-above {
    padding-block-start: var(--rkui-space-7);
  }
</style>
