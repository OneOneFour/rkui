---
import StickyNote from '@oneonefour/rkui/components/sticky-note/StickyNote.astro'
---

<div class="notes">
  <StickyNote title="Yellow">
    <p>Pack my box with five dozen liquor jugs.</p>
  </StickyNote>
  <StickyNote title="Sky" hue="sky">
    <p>Pack my box with five dozen liquor jugs.</p>
  </StickyNote>
  <StickyNote title="Tangerine" hue="tangerine">
    <p>Pack my box with five dozen liquor jugs.</p>
  </StickyNote>
  <StickyNote title="Green" hue="green">
    <p>Pack my box with five dozen liquor jugs.</p>
  </StickyNote>
  <StickyNote title="Coral" hue="coral">
    <p>Pack my box with five dozen liquor jugs.</p>
  </StickyNote>
  <StickyNote title="Grape" hue="grape">
    <p>Pack my box with five dozen liquor jugs.</p>
  </StickyNote>
</div>

<style>
  .notes {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    align-items: start;
    gap: var(--rkui-space-6);
    inline-size: 100%;
    padding-block: var(--rkui-space-3);
  }
</style>
