---
import StickyNote from '@oneonefour/rkui/components/sticky-note/StickyNote.astro'
import ImageIcon from '@oneonefour/rkui/icons/image.svg'
---

<div class="notes">
  <StickyNote title="Linked note" href="#" meta="Meta line">
    <p>Body text.</p>
  </StickyNote>
  <StickyNote title="With an image" href="#" meta="Meta line" hue="green">
    <div slot="image" class="rkui-card-image placeholder">
      <ImageIcon class="rkui-icon" />
    </div>
    <p>Body text.</p>
  </StickyNote>
</div>

<style>
  .notes {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    align-items: start;
    gap: var(--rkui-space-6);
    inline-size: 100%;
    padding-block: var(--rkui-space-3);
  }
</style>

<style>
  .placeholder {
    display: grid;
    place-items: center;
    background: var(--rkui-teal-tint);
    --rkui-icon-fill: var(--rkui-teal);
  }

  .placeholder :global(.rkui-icon) {
    inline-size: 3rem;
    block-size: 3rem;
  }
</style>
