---
import Dots from '@oneonefour/rkui/components/spinner-dots/Dots.astro'
import Flask from '@oneonefour/rkui/components/water/Flask.astro'
import Loader from '@oneonefour/rkui/components/loader/Loader.astro'
import Motion from '@oneonefour/rkui/components/motion/Motion.astro'
import Spinner from '@oneonefour/rkui/components/spinner/Spinner.astro'
---

<Motion>
  <div class="loops">
    <Spinner />
    <Dots />
    <Flask />
    <Loader />
  </div>
</Motion>

<style>
  .loops {
    margin-block-start: var(--rkui-space-4);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--rkui-space-6);
  }
</style>
