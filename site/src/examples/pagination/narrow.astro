---
import Pagination from '@oneonefour/rkui/components/pagination/Pagination.astro'
---

<Pagination current={5} total={12} href={(page) => `#page-${page}`} class="narrow">
  <p>Page 5, in a narrow folder: a scrollbar sits above the tabs.</p>
</Pagination>

<style>
  :global(.narrow) {
    max-inline-size: 16rem;
  }
</style>
