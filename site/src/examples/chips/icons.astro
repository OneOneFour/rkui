---
import ChipGroup from '@oneonefour/rkui/components/chip/ChipGroup.astro'
import Chip from '@oneonefour/rkui/components/chip/Chip.astro'
import Leaf from '@oneonefour/rkui/icons/leaf.svg'
import Sun from '@oneonefour/rkui/icons/sun.svg'
---

<ChipGroup legend="Topics" multiple>
  <Chip value="leaf" checked>
    <Leaf class="rkui-icon" />
    Leaf
  </Chip>
  <Chip value="sun">
    <Sun class="rkui-icon" />
    Sun
  </Chip>
</ChipGroup>
