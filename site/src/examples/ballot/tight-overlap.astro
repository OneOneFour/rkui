---
import Ballot from '@oneonefour/rkui/components/ballot/Ballot.astro'
import BallotOption from '@oneonefour/rkui/components/ballot/BallotOption.astro'
---

<Ballot legend="Vote" tight overlap>
  <BallotOption value="first" mark="A" checked>
    First choice
  </BallotOption>
  <BallotOption value="second" mark="B">
    Second choice
  </BallotOption>
  <BallotOption value="third" mark="C">
    Third choice
  </BallotOption>
</Ballot>
