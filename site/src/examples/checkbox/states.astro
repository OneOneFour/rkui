---
import Checkbox from '@oneonefour/rkui/components/checkbox/Checkbox.astro'
---

<Checkbox name="checkbox-on" checked>
  On
</Checkbox>
<Checkbox name="checkbox-disabled" disabled>
  Disabled
</Checkbox>
<Checkbox name="checkbox-disabled-on" checked disabled>
  Disabled, on
</Checkbox>
<Checkbox name="checkbox-error" aria-invalid="true">
  Error
</Checkbox>
