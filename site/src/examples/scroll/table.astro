---
import Scroll from '@oneonefour/rkui/components/overflow/Scroll.astro'

const head = ['Run', 'σ', 'ρ', 'β', 'Δt', 'Steps', 'x₀', 'y₀', 'z₀', 'λ₁', 'max |x|', 'Wall time']
const rows = [
  ['a', '10', '28', '2.667', '0.01', '10 000', '1.0', '1.0', '1.0', '0.906', '19.6', '0.8 s'],
  ['b', '10', '99.96', '2.667', '0.005', '20 000', '0.1', '0.0', '0.0', '1.42', '41.3', '1.7 s'],
]
---

<Scroll label="Wide table" class="table-scroll">
  <table>
    <thead>
      <tr>
        {head.map((heading) => (
          <th scope="col">{heading}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          {row.map((cell) => (
            <td>{cell}</td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</Scroll>

<style>
  :global(.table-scroll) {
    max-inline-size: 100%;
    padding-block-end: var(--rkui-space-2);
  }

  table {
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  th,
  td {
    padding: var(--rkui-space-1) var(--rkui-space-3);
    text-align: start;
    white-space: nowrap;
  }
</style>
