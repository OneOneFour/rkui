---
import Loader from '@oneonefour/rkui/components/loader/Loader.astro'
import AtomIcon from '@oneonefour/rkui/icons/atom.svg'
import LightningIcon from '@oneonefour/rkui/icons/lightning.svg'
import StarIcon from '@oneonefour/rkui/icons/star.svg'
---

<Loader hue="yellow">
  <StarIcon class="rkui-icon" aria-hidden="true" />
</Loader>
<Loader hue="green">
  <AtomIcon class="rkui-icon" aria-hidden="true" />
</Loader>
<Loader hue="navy">
  <LightningIcon class="rkui-icon" aria-hidden="true" />
</Loader>
