---
/**
 * A file input, in two variants, inside a Field. `class` and `style` go on the Field's div when
 * there is a label, hint or error, otherwise on the outer element (the input, or the drop panel's
 * label); other attributes (name, accept, multiple, disabled, ...) go on the input. Without a
 * label, give it an `aria-label`; the 'drop' variant is labelled by its own text.
 *
 * @example
 *   <File variant="drop" name="upload" prompt="Choose a file or drop it here" />
 */
import type { HTMLAttributes } from 'astro/types'
import UploadIcon from '@oneonefour/rkui/icons/upload-simple.svg'
import Field from '../field/Field.astro'
import { fieldAttrs } from '../../shared/field-attrs'
import { uniqueId } from '../../shared/unique-id'

interface Props extends Omit<HTMLAttributes<'input'>, 'type'> {
  /** 'button' (A: the input frame with a small button and the filename) or 'drop' (B: a dashed
   * panel that takes clicks and dropped files, without the chosen filename); button when left out.
   * Open, see DECISIONS ("Special inputs"). */
  variant?: 'button' | 'drop'
  /** The drop panel's text, for the 'drop' variant; "Choose a file or drop it here" when left out. */
  prompt?: string
  /** The visible label; none when left out. */
  label?: string
  /** A quiet line under the input; none when left out. */
  hint?: string
  /** An error line under the input; it also marks the input invalid. */
  error?: string
}

const {
  variant = 'button',
  prompt = 'Choose a file or drop it here',
  label,
  hint,
  error,
  class: className,
  style,
  ...attrs
} = Astro.props

const framed = Boolean(label || hint || error)
const id = attrs.id ?? uniqueId('rkui-file')
const inputAttrs = framed ? fieldAttrs(id, { hint, error }, attrs) : attrs
const outerClass = !framed && className
const outerStyle = framed ? undefined : style
---

<Field {label} for={id} {hint} {error} class={className} {style}>
  {variant === 'drop' ? (
    <label class:list={['rkui-file-drop', outerClass]} style={outerStyle}>
      <input type="file" {...inputAttrs} />
      <UploadIcon class="rkui-icon" aria-hidden="true" />
      <span>{prompt}</span>
    </label>
  ) : (
    <input class:list={['rkui-input', outerClass]} style={outerStyle} type="file" {...inputAttrs} />
  )}
</Field>
