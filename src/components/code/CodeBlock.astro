---
/**
 * A highlighted code block: rkui's code-block markup around Astro's `<Code>`, with the syntax
 * colours taken from the --rkui-code-* tokens. `class` goes on the `<figure>` and `preClass` on the
 * scrolling `<pre>`. With no `label` there is no title area: the copy button sits in the code's
 * top-right corner, and `copy={false}` leaves it out.
 *
 * The caption starts with a mark for the language, the first of these that exists:
 *   1. the site's logo, in the "logo" slot (an inline SVG with class="rkui-icon rkui-icon--small"
 *      and aria-hidden="true"), e.g. <CodeBlock …><PythonLogo slot="logo" class="…" /></CodeBlock>
 *   2. the library's Phosphor file-type icon for the language (FILE_ICONS below)
 *   3. the file extension as grey text, e.g. "JS" (FILE_EXTENSIONS below), unless it would
 *      repeat the label, as for JSON
 *
 * @example
 * <CodeBlock code="print('hi')" lang="python" label="Python" />
 * <CodeBlock code="print('hi')" lang="python" copy={false} />
 */
import { Code } from 'astro:components'
import type { BuiltinLanguage } from 'shiki'
import CopyIcon from '@oneonefour/rkui/icons/copy.svg'
import FileCIcon from '@oneonefour/rkui/icons/file-c.svg'
import FileCppIcon from '@oneonefour/rkui/icons/file-cpp.svg'
import FileCSharpIcon from '@oneonefour/rkui/icons/file-c-sharp.svg'
import FileCssIcon from '@oneonefour/rkui/icons/file-css.svg'
import FileHtmlIcon from '@oneonefour/rkui/icons/file-html.svg'
import FileJsIcon from '@oneonefour/rkui/icons/file-js.svg'
import FileJsxIcon from '@oneonefour/rkui/icons/file-jsx.svg'
import FileMdIcon from '@oneonefour/rkui/icons/file-md.svg'
import FilePyIcon from '@oneonefour/rkui/icons/file-py.svg'
import FileRsIcon from '@oneonefour/rkui/icons/file-rs.svg'
import FileSqlIcon from '@oneonefour/rkui/icons/file-sql.svg'
import FileTsIcon from '@oneonefour/rkui/icons/file-ts.svg'
import FileTsxIcon from '@oneonefour/rkui/icons/file-tsx.svg'
import FileVueIcon from '@oneonefour/rkui/icons/file-vue.svg'

interface Props {
  /** The source to show. */
  code: string
  /** A Shiki language id, e.g. "python". */
  lang: string
  /** The language name shown in the caption; no caption (no title area) when left out. */
  label?: string
  /** Whether to show the copy button; true when left out. */
  copy?: boolean
  /** Extra classes for the figure, e.g. a box variant. */
  class?: string
  /** Extra classes for the scrolling `<pre>`; `rkui-scroll--bar` keeps its scrollbar visible. */
  preClass?: string
}

/** Phosphor file-type icons by Shiki language id or common alias. */
const FILE_ICONS: Record<string, typeof FilePyIcon> = {
  c: FileCIcon,
  cpp: FileCppIcon,
  'c++': FileCppIcon,
  csharp: FileCSharpIcon,
  'c#': FileCSharpIcon,
  css: FileCssIcon,
  html: FileHtmlIcon,
  javascript: FileJsIcon,
  js: FileJsIcon,
  jsx: FileJsxIcon,
  markdown: FileMdIcon,
  md: FileMdIcon,
  python: FilePyIcon,
  py: FilePyIcon,
  rust: FileRsIcon,
  rs: FileRsIcon,
  sql: FileSqlIcon,
  typescript: FileTsIcon,
  ts: FileTsIcon,
  tsx: FileTsxIcon,
  vue: FileVueIcon,
}

/** File extensions for Shiki language ids whose id is not the extension. */
const FILE_EXTENSIONS: Record<string, string> = {
  'fortran-fixed-form': 'f',
  'fortran-free-form': 'f90',
  julia: 'jl',
  latex: 'tex',
}

const { code, lang, label, copy = true, class: className, preClass } = Astro.props
const FileIcon = FILE_ICONS[lang]
const extension = FILE_EXTENSIONS[lang] ?? lang

// The mark before the label, the first that applies: the site's logo, the library's file-type
// icon, the extension as text, or nothing when the extension would just repeat the label (JSON).
let mark: 'logo' | 'icon' | 'extension' | 'none'
if (Astro.slots.has('logo')) mark = 'logo'
else if (lang in FILE_ICONS) mark = 'icon'
else if (extension.toLowerCase() !== label?.toLowerCase()) mark = 'extension'
else mark = 'none'
---

<rkui-code-block>
  <figure class:list={['rkui-code', className]}>
    {label && (
      <figcaption class="rkui-code-header">
        <span class="rkui-code-lang">
          {mark === 'logo' && <slot name="logo" />}
          {mark === 'icon' && <FileIcon class="rkui-icon rkui-icon--small" aria-hidden="true" />}
          {mark === 'extension' && <span aria-hidden="true">{extension}</span>}
          {label}
        </span>
      </figcaption>
    )}
    <Code
      code={code}
      lang={lang as BuiltinLanguage}
      theme="css-variables"
      class:list={['rkui-scroll', preClass]}
    />
    {copy && (
      <button type="button" class="rkui-button rkui-button--small rkui-code-copy" hidden>
        <CopyIcon class="rkui-icon rkui-icon--small" />
        <span class="rkui-code-copy-label">Copy</span>
      </button>
    )}
  </figure>
</rkui-code-block>

<script>
  import '@oneonefour/rkui/components/code/code-block.js'
</script>
