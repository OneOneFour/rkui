---
/**
 * A top bar: controls that stay at the top of the window as the page scrolls. The slot holds the
 * controls; put a `BackToTop` last. `class`, `style` and other attributes go on the `<header>`.
 *
 * @example
 * <TopBar><ThemeToggle /><BackToTop /></TopBar>
 */
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'header'> {
  /**
   * Full width along the top edge with a rule and a shadow, for headers such as an article's title;
   * a raised toast at the end of the line when left out.
   */
  flush?: boolean
}

const { flush = false, class: className, ...attrs } = Astro.props
---

<header
  class:list={['rkui-topbar', flush ? 'rkui-topbar--flush' : 'rkui-topbar--toast', className]}
  {...attrs}
>
  <slot />
</header>
