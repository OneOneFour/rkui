---
/**
 * A static folder: a strip of tabs over a sheet, inside `<rkui-folder>`, which puts a scrollbar
 * above the strip when the tabs don't fit. The tabs only show which one is selected; for tabs that
 * switch panels use `Tabs`. Each `Tab` in the slot is one tab, and the rest of the slot is the
 * sheet. `class`, `style` and other attributes go on the `<rkui-folder>`.
 *
 * @example
 * <Folder label="Example">
 *   <Tab label="One" />
 *   <Tab label="Two" selected />
 *   <p>Sheet for two.</p>
 * </Folder>
 */
import type { HTMLAttributes } from 'astro/types'
import { readTabs, strayContent } from './tab-items'

interface Props extends HTMLAttributes<'div'> {
  /** The strip's accessible name; "Folder" when left out. */
  label?: string
  /** A sheet in the selected tint instead of the raised surface. */
  tinted?: boolean
}

const { label = 'Folder', tinted = false, class: className, ...attrs } = Astro.props
// Everything that isn't a Tab is the sheet.
const { tabs, outside: sheet } = readTabs(await Astro.slots.render('default'), 'Folder')
if (tabs.some((tab) => strayContent(tab.content))) {
  throw new Error('Folder: a Tab in a Folder has no content; the sheet is the rest of the slot.')
}
---

<rkui-folder class:list={['rkui-folder', { 'rkui-folder--tinted': tinted }, className]} {...attrs}>
  <div class="rkui-folder-tabs rkui-scroll" role="tablist" aria-label={label}>
    {tabs.map((tab) => (
      <button
        class="rkui-folder-tab"
        type="button"
        role="tab"
        aria-selected={tab.selected ? 'true' : 'false'}
        tabindex={tab.selected ? undefined : -1}
      >
        {tab.label}
      </button>
    ))}
  </div>
  <div class="rkui-folder-sheet" role="tabpanel" set:html={sheet} />
</rkui-folder>

<script>
  import '@oneonefour/rkui/components/folder/folder.js'
</script>
