---
/**
 * Breadcrumbs: the trail of pages leading to this one, in a `<nav>` with an ordered list. The last
 * item is the current page, marked `aria-current="page"`. `class`, `style` and other attributes go
 * on the `<nav>`.
 *
 * @example
 * <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Docs', href: '/docs/' }]} />
 */
import type { HTMLAttributes } from 'astro/types'

interface Item {
  label: string
  href: string
}

interface Props extends HTMLAttributes<'nav'> {
  /** The trail, each a label and the link's href. */
  items: Item[]
  /**
   * 'chips' or 'path' (a path bar with slashes); 'plain' links when left out. Open, see DECISIONS
   * ("Breadcrumbs").
   */
  variant?: 'plain' | 'chips' | 'path'
  /** The nav's accessible name; "Breadcrumb" when left out. */
  label?: string
}

const { items, variant = 'plain', label = 'Breadcrumb', class: className, ...attrs } = Astro.props
---

<nav
  class:list={['rkui-breadcrumbs', { 'rkui-breadcrumbs--path': variant === 'path' }, className]}
  aria-label={label}
  {...attrs}
>
  <ol>
    {items.map((item, i) => (
      <li>
        <a
          class={variant === 'chips' ? 'rkui-chip' : undefined}
          href={item.href}
          aria-current={i === items.length - 1 ? 'page' : undefined}
        >
          {item.label}
        </a>
      </li>
    ))}
  </ol>
</nav>
