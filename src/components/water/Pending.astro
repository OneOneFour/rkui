---
/**
 * The pending panel: a dashed panel that fills with water while content loads, with the slot as its
 * text. A busy indicator with `role="status"`. `class` and other attributes go on the `<div>`.
 *
 * @example
 * <Pending>Loading the comments…</Pending>
 */
import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'div'>

const { class: className, ...attrs } = Astro.props
---

<div class:list={['rkui-pending', className]} role="status" {...attrs}>
  <span class="rkui-water rkui-water--rise" aria-hidden="true"></span>
  <p>
    <slot />
  </p>
</div>
