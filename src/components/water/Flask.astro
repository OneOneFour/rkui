---
/**
 * The water flask: a spinner whose water fills and drains, for a wait of unknown length. A busy
 * indicator with `role="status"`; the label is read out, not shown. `class`, `style` and other
 * attributes go on the `<span>`.
 *
 * @example
 * <Flask label="Uploading…" size="3rem" hue="teal" />
 */
import type { HTMLAttributes } from 'astro/types'
import type { Hue } from '../../shared/hues'
import { styleVars } from '../../shared/style-vars'

interface Props extends HTMLAttributes<'span'> {
  /** What is happening, for screen readers; "Loading…" when left out. */
  label?: string
  /** The flask's size as a CSS length; 2rem when left out. */
  size?: string
  /** The water's colour; sky when left out. */
  hue?: Hue
}

const { label = 'Loading…', size, hue, class: className, style, ...attrs } = Astro.props
const inlineStyle = styleVars(
  { '--rkui-spinner-size': size, '--rkui-spinner-fill': hue && `var(--rkui-${hue})` },
  style,
)
---

<span
  class:list={['rkui-spinner', 'rkui-spinner--water', className]}
  role="status"
  style={inlineStyle}
  {...attrs}
>
  <span class="rkui-water rkui-water--rise" aria-hidden="true"></span>
  <span class="rkui-visually-hidden">{label}</span>
</span>
