---
/**
 * An rkui callout: a tint panel with an icon and the slot as its text. `class`, `style` and other
 * attributes go on the outer `<div>`.
 *
 * @example
 * <Callout kind="warning" title="Back up first"><p>This cannot be undone.</p></Callout>
 */
import type { HTMLAttributes } from 'astro/types'
import InfoIcon from '@oneonefour/rkui/icons/info.svg'
import WarningIcon from '@oneonefour/rkui/icons/warning.svg'

interface Props extends HTMLAttributes<'div'> {
  /** 'note' or 'warning'; 'note' when left out. */
  kind?: 'note' | 'warning'
  /** A bold first line; none when left out. */
  title?: string
}

const { kind = 'note', title, class: className, ...attrs } = Astro.props
const Icon = kind === 'warning' ? WarningIcon : InfoIcon
---

<div class:list={['rkui-callout', `rkui-callout--${kind}`, className]} role="note" {...attrs}>
  <Icon class="rkui-icon" />
  <div class="rkui-callout-body">
    {title && <p class="rkui-callout-title">{title}</p>}
    <slot />
  </div>
</div>
