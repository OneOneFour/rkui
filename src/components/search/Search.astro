---
/**
 * A search field, in two variants, inside a Field. `class` and `style` go on the Field's div when
 * there is a label, hint or error, otherwise on the outer element (the div, or the form); other
 * attributes (name, value, placeholder, disabled, ...) go on the input. Without a label the input
 * gets `aria-label="Search"`; pass your own `aria-label` to change it.
 *
 * @example
 *   <Search variant="button" name="q" placeholder="Search" action="/search" />
 */
import type { HTMLAttributes } from 'astro/types'
import SearchIcon from '@oneonefour/rkui/icons/magnifying-glass.svg'
import Button from '../button/Button.astro'
import Field from '../field/Field.astro'
import { fieldAttrs } from '../../shared/field-attrs'
import { uniqueId } from '../../shared/unique-id'

interface Props extends Omit<HTMLAttributes<'input'>, 'type'> {
  /** 'icon' (A: a magnifying glass inside the field) or 'button' (B: a filled Search button
   * joined to the field, in a `<form role="search">`); icon when left out. Open, see DECISIONS
   * ("Special inputs"). */
  variant?: 'icon' | 'button'
  /** The button's text, for the 'button' variant; "Search" when left out. */
  buttonLabel?: string
  /** The form's action, for the 'button' variant; the current page when left out. */
  action?: string
  /** The form's method, for the 'button' variant; get when left out. */
  method?: 'get' | 'post'
  /** The visible label; none when left out. */
  label?: string
  /** A quiet line under the field; none when left out. */
  hint?: string
  /** An error line under the field; it also marks the input invalid. */
  error?: string
}

const {
  variant = 'icon',
  buttonLabel = 'Search',
  action,
  method,
  label,
  hint,
  error,
  class: className,
  style,
  ...attrs
} = Astro.props

const framed = Boolean(label || hint || error)
const id = attrs.id ?? uniqueId('rkui-search')
const inputAttrs = {
  'aria-label': label ? undefined : 'Search',
  ...(framed ? fieldAttrs(id, { hint, error }, attrs) : attrs),
}
const isForm = variant === 'button'
const Bar = isForm ? 'form' : 'div'
const barClass = isForm ? 'rkui-search-bar' : 'rkui-search'
const barAttrs: HTMLAttributes<'form'> = isForm ? { role: 'search', action, method } : {}
---

<Field {label} for={id} {hint} {error} class={className} {style}>
  <Bar
    class:list={[barClass, !framed && className]}
    style={framed ? undefined : style}
    {...barAttrs}
  >
    <input class="rkui-input" type="search" {...inputAttrs} />
    {isForm && (
      <Button type="submit" disabled={attrs.disabled}>
        <SearchIcon class="rkui-icon rkui-icon--small" aria-hidden="true" />
        {buttonLabel}
      </Button>
    )}
  </Bar>
</Field>
