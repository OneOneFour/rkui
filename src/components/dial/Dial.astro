---
/**
 * A rotary dial for a number: rkui's `<rkui-dial>` around a labelled range and its readout. The
 * face is drawn here at build time and the script makes it work; without the script the range and
 * readout show side by side. `class`, `style` and
 * other attributes go on the `<rkui-dial>` element.
 *
 * @example
 * <Dial label="Temperature" min={10} max={30} step={0.5} value={20} variant="arc" ramp="heat" />
 */
import type { HTMLAttributes } from 'astro/types'
import { uniqueId } from '../../shared/unique-id'
import { dialFace } from '../../shared/dial-face.js'

interface Props extends HTMLAttributes<'div'> {
  /** The dial's visible label, which is also its accessible name. */
  label: string
  /** The starting value. */
  value: number
  /** The lowest value; 0 when left out. */
  min?: number
  /** The highest value; 100 when left out. */
  max?: number
  /** The step between values; 1 when left out. */
  step?: number
  /** 'arc'; 'knob' when left out. Open, see DECISIONS ("Dial"). */
  variant?: 'knob' | 'arc'
  /**
   * A ring of blocks that light up to the value: 'cool' (cool to warm) or 'heat' (yellow to coral);
   * no ramp when left out. Open, see DECISIONS ("Dial").
   */
  ramp?: 'cool' | 'heat'
  /** The range's form field name. */
  name?: string
  /** The range's id; made up when left out. */
  id?: string
  /** Greys the dial out and stops it changing; enabled when left out. */
  disabled?: boolean
}

const {
  label,
  value,
  min = 0,
  max = 100,
  step = 1,
  variant = 'knob',
  ramp,
  name,
  id = uniqueId('rkui-dial'),
  disabled = false,
  class: className,
  ...attrs
} = Astro.props
// How many colours each ramp has: --rkui-dial-ramp-steps in dial.css.
const rampSteps = ramp === 'heat' ? 3 : ramp === 'cool' ? 6 : 0
const face = dialFace({ min, max, value, arc: variant === 'arc', rampSteps })
const classes = [
  'rkui-dial',
  `rkui-dial--${variant}`,
  ramp && 'rkui-dial--ramp',
  ramp === 'heat' && 'rkui-dial--ramp-heat',
  className,
]
---

<rkui-dial class:list={classes} {...attrs}>
  <label for={id}>{label}</label>
  <div class="rkui-dial-face" aria-hidden="true" style={face.style} set:html={face.html} />
  <input
    class="rkui-range"
    type="range"
    id={id}
    name={name}
    min={min}
    max={max}
    step={step}
    value={value}
    disabled={disabled}
  />
  <output class="rkui-output" for={id}>
    {value}
  </output>
</rkui-dial>

<script>
  import '@oneonefour/rkui/components/dial/dial.js'
</script>
