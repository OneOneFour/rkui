---
/**
 * An rkui card: an `<article>` with a title and a body. With `href` the whole card is one link (its
 * title); without, it is a static panel. Slots: `image` (an <img class="rkui-card-image"> or
 * similar) and the default slot for the body. `class`, `style` and other attributes go on the
 * `<article>`.
 *
 * @example
 * <Card title="Field notes" href="/notes/" meta="Updated today"><p>Recent entries.</p></Card>
 */
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'article'> {
  /** The card's title, and the link text when linked. */
  title: string
  /** Where the card links to; a static panel when left out. */
  href?: string
  /** A short line under the title. */
  meta?: string
  /** The title's heading level, to fit the page outline; 3 when left out. */
  headingLevel?: 2 | 3 | 4
}

const { title, href, meta, headingLevel = 3, class: className, ...attrs } = Astro.props
const Heading = `h${headingLevel}` as const
---

<article class:list={['rkui-card', { 'rkui-card--link': href }, className]} {...attrs}>
  <slot name="image" />
  <div class="rkui-card-body">
    <Heading class="rkui-card-title">
      {href ? (
        <a class="rkui-card-link" href={href}>
          {title}
        </a>
      ) : (
        title
      )}
    </Heading>
    {meta && <p class="rkui-card-meta">{meta}</p>}
    <slot />
  </div>
</article>
