---
/**
 * A number input with step buttons in place of the browser's spinners, in a `<rkui-stepper>`
 * inside a Field. The buttons step by `step` within `min` and `max`. `class` and `style` go on the
 * Field's div when there is a label, hint or error, otherwise on the `<rkui-stepper>`; other
 * attributes (name, value, min, max, step, disabled, aria-label, ...) go on the input. Without a
 * label, give it an `aria-label`.
 *
 * @example
 *   <Stepper label="Quantity" name="quantity" min="0" max="10" value="3" />
 */
import type { HTMLAttributes } from 'astro/types'
import CaretUpIcon from '@oneonefour/rkui/icons/caret-up.svg'
import CaretDownIcon from '@oneonefour/rkui/icons/caret-down.svg'
import Button from '../button/Button.astro'
import Field from '../field/Field.astro'
import { fieldAttrs } from '../../shared/field-attrs'
import { uniqueId } from '../../shared/unique-id'

interface Props extends Omit<HTMLAttributes<'input'>, 'type'> {
  /** 'split' (a - and a + button either side of the field) or 'stacked' (up and down arrows
   * inside the field's end); split when left out. Open, see DECISIONS ("Number stepper"). */
  variant?: 'split' | 'stacked'
  /** The visible label; none when left out. */
  label?: string
  /** A quiet line under the stepper; none when left out. */
  hint?: string
  /** An error line under the stepper; it also marks the input invalid. */
  error?: string
}

const { variant = 'split', label, hint, error, class: className, style, ...attrs } = Astro.props

const framed = Boolean(label || hint || error)
const id = attrs.id ?? uniqueId('rkui-stepper')
const inputAttrs = framed ? fieldAttrs(id, { hint, error }, attrs) : attrs
const split = variant === 'split'
---

<Field {label} for={id} {hint} {error} class={className} {style}>
  <rkui-stepper
    class:list={['rkui-stepper', `rkui-stepper--${variant}`, !framed && className]}
    style={framed ? undefined : style}
  >
    {split && (
      <Button data-step="down" aria-label="Decrease" disabled={attrs.disabled}>
        {'−'}
      </Button>
    )}
    <input class="rkui-input" type="number" {...inputAttrs} />
    {split ? (
      <Button data-step="up" aria-label="Increase" disabled={attrs.disabled}>
        {'+'}
      </Button>
    ) : (
      <>
        <button
          type="button"
          tabindex="-1"
          data-step="up"
          aria-label="Increase"
          disabled={attrs.disabled}
        >
          <CaretUpIcon aria-hidden="true" />
        </button>
        <button
          type="button"
          tabindex="-1"
          data-step="down"
          aria-label="Decrease"
          disabled={attrs.disabled}
        >
          <CaretDownIcon aria-hidden="true" />
        </button>
      </>
    )}
  </rkui-stepper>
</Field>

<script>
  import '@oneonefour/rkui/components/number/stepper.js'
</script>
