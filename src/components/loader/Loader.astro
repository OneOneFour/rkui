---
/**
 * The hop loader: a ball hops back and forth along a line, squashing as it lands. Give it a hue, or
 * an icon to ride in a bigger ball (the slot: an imported .svg with class "rkui-icon"). A busy
 * indicator with `role="status"`; the label is read out, not shown. `class`, `style` and other
 * attributes go on the `<div>`.
 *
 * @example
 * <Loader hue="coral" label="Fetching…"><StarIcon class="rkui-icon" aria-hidden="true" /></Loader>
 */
import type { HTMLAttributes } from 'astro/types'
import { onHue, type Hue } from '../../shared/hues'
import { styleVars } from '../../shared/style-vars'

interface Props extends HTMLAttributes<'div'> {
  /** What is happening, for screen readers; "Loading…" when left out. */
  label?: string
  /** The ball's colour; teal when left out. */
  hue?: Hue
}

const { label = 'Loading…', hue, class: className, style, ...attrs } = Astro.props
const hasIcon = Astro.slots.has('default')
const inlineStyle = styleVars(
  {
    '--rkui-loader-fill': hue && `var(--rkui-${hue})`,
    '--rkui-loader-on-fill': hasIcon && hue ? `var(${onHue(hue)})` : undefined,
  },
  style,
)
---

<div
  class:list={['rkui-loader', 'rkui-loader--hop', className]}
  role="status"
  style={inlineStyle}
  {...attrs}
>
  {hasIcon && (
    <span class="rkui-loader-ball">
      <slot />
    </span>
  )}
  <span class="rkui-visually-hidden">{label}</span>
</div>
