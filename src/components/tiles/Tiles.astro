---
/**
 * A tile picker: a group of equal round tiles (Tile), radios for one choice or checkboxes for
 * several, each holding a number, a letter or an icon. `class`, `style` and other attributes go on
 * the fieldset (`disabled` disables the whole group).
 *
 * For colour tiles, see ColorPicker.
 *
 * @example
 * <Tiles legend="Rating">
 *   <Tile value="1">1</Tile>
 *   <Tile value="2" checked>2</Tile>
 * </Tiles>
 */
import type { HTMLAttributes } from 'astro/types'
import { fillOptions } from '../../shared/option-group'
import { uniqueId } from '../../shared/unique-id'

interface Props extends HTMLAttributes<'fieldset'> {
  /** The group's name, visually hidden. */
  legend: string
  /** The inputs' name, filled into every tile; a unique one is made when left out. */
  name?: string
  /** Checkboxes instead of radios. */
  multiple?: boolean
  /** Smaller tiles. */
  compact?: boolean
  /** Stack the tiles in a column. */
  vertical?: boolean
}

const {
  legend,
  name = uniqueId('rkui-tiles'),
  multiple = false,
  compact = false,
  vertical = false,
  class: className,
  ...attrs
} = Astro.props

const tiles = fillOptions(await Astro.slots.render('default'), name, multiple)
---

<fieldset
  class:list={[
    'rkui-tiles',
    { 'rkui-tiles--compact': compact, 'rkui-tiles--vertical': vertical },
    className,
  ]}
  {...attrs}
>
  <legend class="rkui-visually-hidden">{legend}</legend>
  <Fragment set:html={tiles} />
</fieldset>
