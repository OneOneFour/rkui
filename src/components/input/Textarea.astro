---
/**
 * A multi-line text input: a native `<textarea>` in the `.rkui-input` frame, inside a Field. `class`
 * and `style` go on the Field's div when there is a label, hint or error, otherwise on the
 * textarea; other attributes (name, rows, placeholder, disabled, ...) go on the textarea, and its
 * text goes in the slot. Without a label, give it an `aria-label`.
 *
 * @example
 *   <Textarea label="Message" name="message" rows="4" />
 */
import type { HTMLAttributes } from 'astro/types'
import Field from '../field/Field.astro'
import { fieldAttrs } from '../../shared/field-attrs'
import { uniqueId } from '../../shared/unique-id'

interface Props extends HTMLAttributes<'textarea'> {
  /** The visible label; none when left out. */
  label?: string
  /** A quiet line under the textarea; none when left out. */
  hint?: string
  /** An error line under the textarea; it also marks the textarea invalid. */
  error?: string
  /** The hover cue: 'ring', 'underline' or 'none'; the background sinks to the page colour when
   * left out. */
  hover?: 'ring' | 'underline' | 'none'
}

const { label, hint, error, hover, class: className, style, ...attrs } = Astro.props

// The slot's text is trimmed: a textarea would show the indentation Prettier adds around it.
const text = Astro.slots.has('default') ? (await Astro.slots.render('default')).trim() : ''
const framed = Boolean(label || hint || error)
const id = attrs.id ?? uniqueId('rkui-textarea')
const textareaAttrs = framed ? fieldAttrs(id, { hint, error }, attrs) : attrs
const textareaClass = ['rkui-input', hover && `rkui-hover-${hover}`, !framed && className]
---

<Field {label} for={id} {hint} {error} class={className} {style}>
  <textarea
    class:list={textareaClass}
    style={framed ? undefined : style}
    {...textareaAttrs}
    set:html={text}
  />
</Field>
