---
/**
 * A filter chip: a pill label around a native checkbox or radio. Put an optional icon and the label
 * text in the slot. Put chips in a ChipGroup, which fills in their `name` and input type. `class`
 * and `style` go on the label; other attributes go on the input.
 *
 * @example
 * <Chip value="fruit" checked>Fruit</Chip>
 */
import type { HTMLAttributes } from 'astro/types'
import { NAME_PLACEHOLDER } from '../../shared/option-group'

interface Props extends HTMLAttributes<'input'> {
  value: string
  /** 'checkbox' or 'radio'; a ChipGroup sets it for its chips, so this is for a chip on its own. */
  type?: 'checkbox' | 'radio'
}

const {
  type = 'checkbox',
  name = NAME_PLACEHOLDER,
  value,
  checked,
  disabled,
  class: className,
  style,
  ...attrs
} = Astro.props
---

<label class:list={['rkui-chip', className]} style={style}>
  <input type={type} name={name} value={value} checked={checked} disabled={disabled} {...attrs} />
  <slot />
</label>
