---
/**
 * One colour tile of a ColorPicker: a Tile filled with a hue and named by it. `class` and `style`
 * go on the label; other attributes go on the input.
 *
 * @example
 * <ColorTile hue="teal" checked />
 */
import type { HTMLAttributes } from 'astro/types'
import Tile from '../tiles/Tile.astro'
import type { Hue } from '../../shared/hues'

interface Props extends Omit<HTMLAttributes<'input'>, 'type'> {
  hue: Hue
  type?: 'checkbox' | 'radio'
  /** The input's value; the hue's name when left out. */
  value?: string
}

const { hue, value = hue, ...attrs } = Astro.props
---

<Tile hue={hue} value={value} {...attrs}>
  {hue}
</Tile>
