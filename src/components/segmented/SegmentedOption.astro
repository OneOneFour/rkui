---
/**
 * One option of a Segmented control: a label around a native radio. Put an optional icon
 * (`slot="icon"`) and the label text in the slot. `class` and `style` go on the label; other
 * attributes go on the input.
 *
 * @example
 * <SegmentedOption value="dark"><MoonIcon slot="icon" />Dark</SegmentedOption>
 */
import type { HTMLAttributes } from 'astro/types'
import { NAME_PLACEHOLDER } from '../../shared/option-group'

interface Props extends HTMLAttributes<'input'> {
  value: string
}

const {
  value,
  name = NAME_PLACEHOLDER,
  checked,
  disabled,
  class: className,
  style,
  ...attrs
} = Astro.props

const label = (await Astro.slots.render('default')).trim()
---

<label class={className} style={style}>
  <input
    type="checkbox"
    name={name}
    value={value}
    checked={checked}
    disabled={disabled}
    {...attrs}
  />
  <slot name="icon" />
  <Fragment set:html={label} />
</label>
