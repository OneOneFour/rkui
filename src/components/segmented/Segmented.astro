---
/**
 * A segmented control: a pill group of native radios, built from SegmentedOptions, which can each
 * have an icon before the label. With `deck` it is a row of raised keys, like a tape deck's.
 * `class`, `style` and other attributes go on the fieldset.
 *
 * @example
 * <Segmented legend="View">
 *   <SegmentedOption value="list" checked>List</SegmentedOption>
 *   <SegmentedOption value="grid">Grid</SegmentedOption>
 * </Segmented>
 */
import type { HTMLAttributes } from 'astro/types'
import { fillOptions } from '../../shared/option-group'
import { uniqueId } from '../../shared/unique-id'

interface Props extends HTMLAttributes<'fieldset'> {
  /** The group's name, visually hidden. */
  legend: string
  /** The radios' name, filled into every option; a unique one is made when left out. */
  name?: string
  /** Raised keys instead of a pill. */
  deck?: boolean
  /** For a deck: show its frame as a flat outlined plate. */
  plate?: boolean
}

const {
  legend,
  name = uniqueId('rkui-segmented'),
  deck = false,
  plate = false,
  class: className,
  ...attrs
} = Astro.props

const options = fillOptions(await Astro.slots.render('default'), name, false)
---

<fieldset
  class:list={[
    'rkui-segmented',
    { 'rkui-segmented--deck': deck, 'rkui-segmented--plate': plate },
    className,
  ]}
  {...attrs}
>
  <legend class="rkui-visually-hidden">{legend}</legend>
  <Fragment set:html={options} />
</fieldset>
