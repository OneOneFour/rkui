---
/**
 * `<rkui-motion>`: pauses the animations inside it while it is scrolled out of view, and while the
 * reader has pressed its Pause button. The slot is the animated content. `class`, `style` and other
 * attributes go on the element. Whether `<rkui-motion>` stays in rkui is open, see DECISIONS
 * ("Motion").
 *
 * @example
 * <Motion><Spinner /><Dots /></Motion>
 */
import type { HTMLAttributes } from 'astro/types'
import PauseIcon from '@oneonefour/rkui/icons/pause.svg'
import Button from '../button/Button.astro'

interface Props extends HTMLAttributes<'div'> {
  /** Shows the Pause button before the content; shown when left out. */
  pause?: boolean
}

const { pause = true, ...attrs } = Astro.props
---

<rkui-motion {...attrs}>
  {pause && (
    <Button small data-motion-pause="" aria-pressed="false">
      <PauseIcon class="rkui-icon" aria-hidden="true" />
      Pause
    </Button>
  )}
  <slot />
</rkui-motion>

<script>
  import '@oneonefour/rkui/components/motion/motion.js'
</script>
