---
/**
 * A short plain-text tooltip over a control, shown on hover or focus; Escape hides it. The slot is
 * the control, which must point at the bubble with `aria-describedby` set to this `id`. Anything
 * interactive belongs in a `Popup`. `class`, `style` and other attributes go on the
 * `<rkui-tooltip>` element.
 *
 * @example
 * <Tooltip id="save-tip" text="Save the file">
 *   <Button aria-describedby="save-tip">Save</Button>
 * </Tooltip>
 */
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'div'> {
  /** The bubble's id, which the control's `aria-describedby` names. */
  id: string
  /** The tooltip's text. */
  text: string
  /** 'toon'; 'inverted' when left out. Open, see DECISIONS ("Tooltips and popups"). */
  variant?: 'inverted' | 'toon'
}

const { id, text, variant = 'inverted', class: className, ...attrs } = Astro.props
const classes = ['rkui-tooltip', variant === 'toon' && 'rkui-tooltip--toon', className]
---

<rkui-tooltip class:list={classes} {...attrs}>
  <slot />
  <span class="rkui-tooltip-bubble" id={id} role="tooltip">
    {text}
  </span>
</rkui-tooltip>

<script>
  import '@oneonefour/rkui/components/tooltip/tooltip.js'
</script>
