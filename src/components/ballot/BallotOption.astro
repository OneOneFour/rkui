---
/**
 * One option of a Ballot: a tile beside a bordered text box, in one label. Put the title in the
 * slot, and optionally an icon (`slot="icon"`) for the tile. `class` and `style` go on the label;
 * other attributes go on the input.
 *
 * @example
 * <BallotOption value="a" mark="A" text="A longer line under the title.">First</BallotOption>
 */
import type { HTMLAttributes } from 'astro/types'
import Tile from '../tiles/Tile.astro'
import type { Hue } from '../../shared/hues'
import { styleVars } from '../../shared/style-vars'

interface Props extends Omit<HTMLAttributes<'input'>, 'type'> {
  value: string
  /** A longer line under the title. */
  text?: string
  /** A letter or number for the tile; the tile is empty when it has no mark or icon. */
  mark?: string
  /** A hue: the tile is filled with it when it holds no mark or icon, and `tint` uses it. */
  hue?: Hue
  /** Fill the box with the hue's tint when checked. */
  tint?: boolean
}

const { text, mark, hue, tint = false, class: className, style, ...attrs } = Astro.props

const title = (await Astro.slots.render('default')).trim()
const hasIcon = Astro.slots.has('icon')
const swatch = hue && !mark && !hasIcon
const tintVar = tint && hue ? `var(--rkui-${hue}-tint)` : undefined
---

<label
  class:list={['rkui-ballot-option', className]}
  style={styleVars({ '--rkui-selected-tint': tintVar }, style)}
>
  <Tile tag="span" hue={swatch ? hue : undefined} {...attrs}>
    {!swatch && (hasIcon ? <slot name="icon" /> : mark)}
  </Tile>
  <span class="rkui-ballot-text">
    <strong set:html={title} />
    {text && <span>{text}</span>}
  </span>
</label>
