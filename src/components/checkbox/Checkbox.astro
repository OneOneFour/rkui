---
/**
 * A checkbox: a native checkbox inside a `label.rkui-check`, with the label text in the slot.
 * `class` and `style` go on the label; other attributes (name, value, checked, disabled, required,
 * aria-invalid, ...) go on the input.
 *
 * @example
 *   <Checkbox name="news" checked>Send me the newsletter</Checkbox>
 */
import type { HTMLAttributes } from 'astro/types'

type Props = Omit<HTMLAttributes<'input'>, 'type'>

const { class: className, style, ...attrs } = Astro.props
---

<label class:list={['rkui-check', className]} {style}>
  <input class="rkui-checkbox" type="checkbox" {...attrs} />
  <slot />
</label>
