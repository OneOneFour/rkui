---
/**
 * A range slider: a native `<input type="range">` with a pill track and an outlined thumb, inside
 * a Field. `class` and `style` go on the Field's div when there is a visible label, hint or error,
 * otherwise on the input; other attributes (name, min, max, step, value, disabled, ...) go on the
 * input.
 *
 * With `readout` the value shows in an `<output>` that follows the thumb, kept up to date by
 * `<rkui-range-readout>`. With `ticks` a row of tick marks and value labels sits under the slider;
 * match them to min, max and step so the thumb lands on them.
 *
 * @example
 *   <Range label="Volume" readout min="0" max="100" step="25" ticks={[0, 25, 50, 75, 100]} />
 */
import type { HTMLAttributes } from 'astro/types'
import Field from '../field/Field.astro'
import { fieldAttrs } from '../../shared/field-attrs'
import { uniqueId } from '../../shared/unique-id'

interface Props extends Omit<HTMLAttributes<'input'>, 'type'> {
  /** The slider's name: a visible label with `readout`, otherwise its aria-label. */
  label?: string
  /** A quiet line under the slider; none when left out. */
  hint?: string
  /** An error line under the slider; it also marks the input invalid. */
  error?: string
  /** Show the value in an `<output>` beside the slider; off when left out. */
  readout?: boolean
  /** The values to mark with a tick and a label under the slider; no ticks when left out. */
  ticks?: number[]
}

const {
  label,
  hint,
  error,
  readout = false,
  ticks,
  class: className,
  style,
  ...attrs
} = Astro.props

const id = attrs.id ?? uniqueId('rkui-range')
const listId = `${id}-ticks`
const min = Number(attrs.min ?? 0)
const max = Number(attrs.max ?? 100)
const shown = attrs.value ?? min + (max - min) / 2

const visibleLabel = readout ? label : undefined
const framed = Boolean(visibleLabel || hint || error)
const identified = framed || readout ? fieldAttrs(id, { hint, error }, attrs) : attrs
const inputAttrs = {
  ...identified,
  type: 'range' as const,
  'aria-label': visibleLabel ? undefined : (attrs['aria-label'] ?? label),
  list: ticks ? listId : undefined,
  style: framed ? undefined : style,
}
const inputClass = ['rkui-range', !framed && className]
---

<Field label={visibleLabel} for={id} {hint} {error} class={className} {style}>
  {readout ? (
    <rkui-range-readout class="rkui-range-row">
      <input class:list={inputClass} {...inputAttrs} />
      <output class="rkui-output" for={id}>
        {shown}
      </output>
    </rkui-range-readout>
  ) : (
    <input class:list={inputClass} {...inputAttrs} />
  )}
  {ticks && (
    <datalist class="rkui-range-scale" id={listId}>
      {ticks.map((tick) => (
        <option value={tick}>{tick}</option>
      ))}
    </datalist>
  )}
</Field>

<script>
  import '@oneonefour/rkui/components/range/range-readout.js'
</script>
