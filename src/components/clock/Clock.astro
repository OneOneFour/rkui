---
/**
 * A settable clock: rkui's `<rkui-clock>` around a labelled time input, with a face (a day and
 * night ring, a sun and a moon, and two hands) drawn here at build time. The script makes the face
 * work; without it the label and input show on their own. `class`, `style` and other attributes go on the `<rkui-clock>` element.
 *
 * @example
 * <Clock label="Wake up" value="07:30" />
 */
import type { HTMLAttributes } from 'astro/types'
import Sun from '@oneonefour/rkui/icons/sun.svg'
import Moon from '@oneonefour/rkui/icons/moon.svg'
import { uniqueId } from '../../shared/unique-id'
import { clockFace } from '../../shared/clock-face.js'

interface Props extends HTMLAttributes<'div'> {
  /** The clock's visible label, which is also its accessible name. */
  label: string
  /** The starting time, "HH:MM". */
  value: string
  /** The input's step in seconds; 300 (five minutes) when left out. */
  step?: number
  /** The input's form field name. */
  name?: string
  /** The input's id; made up when left out. */
  id?: string
  /** Greys the clock out and stops it changing; enabled when left out. */
  disabled?: boolean
}

const {
  label,
  value,
  step = 300,
  name,
  id = uniqueId('rkui-clock'),
  disabled = false,
  class: className,
  ...attrs
} = Astro.props
const [hours = 0, minutes = 0] = value.split(':').map(Number)
const face = clockFace(hours, minutes)
---

<rkui-clock class:list={['rkui-clock', className]} {...attrs}>
  <label for={id}>{label}</label>
  <div class="rkui-clock-face" aria-hidden="true" style={face.style}>
    <Fragment set:html={face.svg} />
    <Sun class="rkui-icon rkui-clock-day-icon" aria-hidden="true" />
    <Moon class="rkui-icon rkui-clock-night-icon" aria-hidden="true" />
    <Fragment set:html={face.hands} />
  </div>
  <input
    class="rkui-input"
    type="time"
    id={id}
    name={name}
    step={step}
    value={value}
    disabled={disabled}
  />
</rkui-clock>

<script>
  import '@oneonefour/rkui/components/clock/clock.js'
</script>
